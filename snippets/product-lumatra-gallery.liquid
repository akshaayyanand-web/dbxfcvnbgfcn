{%- comment -%}
  Product media gallery: one shared DOM for mobile (stacked) and desktop (thumb rail + large image);
  responsive placement is handled entirely in CSS (see .plt-gallery in section-product-lumatra.css).
  Thumbnail clicks are wired in assets/section-product-lumatra.js by cloning the matching
  <template data-plt-media-template> into the main viewer — this lets native media_tag markup
  (video / 3D model / external video) work without re-implementing embeds in JS.
  Expects: product
{%- endcomment -%}
{%- liquid
  assign current_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign has_media = product.media.size > 0
-%}
<div class="plt-gallery" data-plt-gallery>
  <div class="plt-gallery__main" data-plt-gallery-main>
    {%- if has_media -%}
      {%- if current_media.media_type == 'image' -%}
        <img
          data-plt-gallery-main-image
          src="{{ current_media | image_url: width: 1200 }}"
          srcset="{{ current_media | image_url: width: 400 }} 400w, {{ current_media | image_url: width: 800 }} 800w, {{ current_media | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 900px) 460px, 100vw"
          alt="{{ current_media.alt | default: product.title | escape }}"
          width="{{ current_media.preview_image.width }}"
          height="{{ current_media.preview_image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        {{ current_media | media_tag: image_size: '1200x1200', loading: 'eager' }}
      {%- endif -%}
    {%- else -%}
      {%- comment -%} No product images yet — bundled demo photography keeps the section pixel-complete while testing. {%- endcomment -%}
      <img src="{{ 'product-lumatra-hero.png' | asset_url }}" alt="{{ product.title | escape }}" width="605" height="618" loading="eager" fetchpriority="high">
    {%- endif -%}
  </div>

  <div class="plt-gallery__thumbs" role="tablist" aria-label="{{ product.title | escape }} media">
    {%- if has_media -%}
      {%- for media in product.media -%}
        <button
          type="button"
          class="plt-gallery__thumb{% if media.id == current_media.id %} is-selected{% endif %}"
          data-plt-gallery-thumb
          data-media-id="{{ media.id }}"
          role="tab"
          aria-selected="{% if media.id == current_media.id %}true{% else %}false{% endif %}"
          aria-label="{{ media.alt | default: product.title | escape }}"
        >
          <img src="{{ media.preview_image | image_url: width: 160 }}" alt="" width="76" height="76" loading="lazy">
        </button>
      {%- endfor -%}
    {%- else -%}
      {%- assign demo_thumbs = 'product-lumatra-hero.png,product-lumatra-gallery-2.png,product-lumatra-gallery-3.png,product-lumatra-gallery-4.png,product-lumatra-gallery-5.png' | split: ',' -%}
      {%- for demo in demo_thumbs -%}
        <button type="button" class="plt-gallery__thumb{% if forloop.first %} is-selected{% endif %}" data-plt-gallery-thumb-demo aria-label="{{ product.title | escape }} photo {{ forloop.index }}">
          <img src="{{ demo | asset_url }}" alt="" width="76" height="76" loading="lazy">
        </button>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if has_media -%}
    <div hidden>
      {%- for media in product.media -%}
        <template data-plt-media-template data-media-id="{{ media.id }}">
          {%- if media.media_type == 'image' -%}
            <img
              data-plt-gallery-main-image
              src="{{ media | image_url: width: 1200 }}"
              srcset="{{ media | image_url: width: 400 }} 400w, {{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 900px) 460px, 100vw"
              alt="{{ media.alt | default: product.title | escape }}"
              width="{{ media.preview_image.width }}"
              height="{{ media.preview_image.height }}"
              loading="lazy"
            >
          {%- else -%}
            {{ media | media_tag: image_size: '1200x1200' }}
          {%- endif -%}
        </template>
      {%- endfor -%}
    </div>

    {%- comment -%} variant_id -> featured_media id, so picking a variant can jump the gallery to its photo {%- endcomment -%}
    <script type="application/json" data-plt-variant-media-map>
      {
        {%- for variant in product.variants -%}
          "{{ variant.id }}": {{ variant.featured_media.id | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }
    </script>
  {%- endif -%}
</div>
