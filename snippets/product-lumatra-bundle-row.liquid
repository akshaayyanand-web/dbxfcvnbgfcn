{%- comment -%}
  One configurator row inside the "Buy 2" bundle picker: a live thumbnail plus one <select>
  per product option, so each bag in the bundle can resolve to its own variant.
  Expects:
    product - the product object
    bag     - 1 or 2 (which bag this row configures)
{%- endcomment -%}
{%- liquid
  assign default_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign thumb = default_variant.featured_image | default: product.featured_image
-%}
<div class="plt-bundle__row" data-plt-bundle-row="{{ bag }}">
  <div class="plt-bundle__row-thumb" data-plt-bundle-row-thumb>
    {%- if thumb -%}
      <img src="{{ thumb | image_url: width: 100 }}" alt="" width="38" height="38" loading="lazy">
    {%- endif -%}
  </div>
  {%- for option in product.options_with_values -%}
    <select
      class="plt-bundle__row-select"
      data-plt-option-position="{{ option.position }}"
      data-plt-bundle-row-select="{{ bag }}"
      aria-label="{{ option.name | escape }} — bag {{ bag }}"
    >
      {%- for value in option.values -%}
        <option value="{{ value | escape }}" {% if value == default_variant.options[option.position | minus: 1] %}selected{% endif %}>{{ value }}</option>
      {%- endfor -%}
    </select>
  {%- endfor -%}
</div>
