{%- comment -%}
  AJAX cart drawer. Content is populated client-side from the real /cart.js on load and after every
  change (see assets/section-product-lumatra.js), so it reflects the actual Shopify cart rather than
  only items added from this section.
{%- endcomment -%}
<dialog class="plt-cart" data-plt-cart aria-labelledby="plt-cart-title-{{ section.id }}">
  <div class="plt-cart__head">
    <span class="plt-cart__title" id="plt-cart-title-{{ section.id }}">Cart • <span data-plt-cart-count>0</span> items</span>
    <button type="button" class="plt-cart__close" data-plt-cart-close aria-label="Close cart">&times;</button>
  </div>
  <div class="plt-cart__insurance">
    {%- render 'icon-product-lumatra', icon: 'shield', width: 18, height: 18, stroke: '#2B2320', stroke_width: 1.4 -%}
    <div>Shop with complete confidence. <strong>Premium Protection Insurance</strong> covers theft, missing items, wrong items, damage &amp; lost packages.</div>
  </div>
  <div class="plt-cart__body" data-plt-cart-body>
    <div class="plt-cart__empty" data-plt-cart-empty hidden>
      <div class="plt-cart__empty-text">Your cart is empty</div>
      <button type="button" class="plt-cart__continue" data-plt-cart-close>Continue shopping</button>
    </div>
    <div data-plt-cart-lines></div>
  </div>
  <form action="{{ routes.cart_url }}" method="post" class="plt-cart__footer" data-plt-cart-footer hidden>
    <div class="plt-cart__subtotal-row"><span>Subtotal</span><span data-plt-cart-subtotal>{{ 0 | money }}</span></div>
    <div class="plt-cart__subtotal-note">Shipping &amp; taxes calculated at checkout</div>
    <button type="submit" name="checkout" class="plt-cart__checkout-btn">Check out</button>
  </form>
</dialog>

<template data-plt-cart-line-template>
  <div class="plt-cart__line">
    <div class="plt-cart__line-left">
      <div class="plt-cart__line-thumb"><img src="" alt="" width="50" height="50" loading="lazy"></div>
      <div class="plt-cart__line-label"></div>
    </div>
    <div class="plt-cart__line-right">
      <span class="plt-cart__line-price"></span>
      <button type="button" class="plt-cart__line-remove">Remove</button>
    </div>
  </div>
</template>
