{%- comment -%}
  Infinite scrolling marquee strip shared by the 4 marquee bands on the page.
  Expects:
    text         - newline-separated items (a section setting)
    duration     - animation duration in seconds
    variant_class - optional extra class (e.g. 'plt-marquee--sale')
{%- endcomment -%}
{%- liquid
  assign items = text | newline_to_br | strip_newlines | split: '<br />'
-%}
<div class="plt-marquee{% if variant_class %} {{ variant_class }}{% endif %}" style="--plt-marquee-duration:{{ duration | default: 22 }}s;">
  <div class="plt-marquee__track">
    {%- for n in (1..2) -%}
      {%- for item in items -%}
        {%- assign trimmed = item | strip -%}
        {%- if trimmed != blank -%}<span class="plt-marquee__item">{{ trimmed }}</span>{%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>
