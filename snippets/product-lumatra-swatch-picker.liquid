{%- comment -%}
  Image-swatch radio picker for one product option (used for the hero "Select Model" row).
  Expects:
    product          - the product object
    option           - an entry from product.options_with_values
    selected_value   - currently selected value string
    section          - current section (for unique input names/ids)
{%- endcomment -%}
{%- liquid
  assign swatch_group = 'plt-style-' | append: section.id
  assign option_index = option.position | minus: 1
-%}
<div class="plt-swatches" data-plt-style-swatches data-option-position="{{ option.position }}" role="radiogroup" aria-label="{{ option.name | escape }}">
  {%- for value in option.values -%}
    {%- liquid
      assign swatch_image = product.featured_image
      for variant in product.variants
        if variant.options[option_index] == value and variant.featured_image
          assign swatch_image = variant.featured_image
          break
        endif
      endfor
      assign input_id = swatch_group | append: '-' | append: forloop.index
    -%}
    <span class="plt-swatch">
      <input
        class="plt-swatch__input"
        type="radio"
        name="{{ swatch_group }}"
        id="{{ input_id }}"
        value="{{ value | escape }}"
        data-plt-option-position="{{ option.position }}"
        {% if value == selected_value %}checked{% endif %}
      >
      <label for="{{ input_id }}" class="plt-swatch__face">
        {%- if swatch_image -%}
          <img src="{{ swatch_image | image_url: width: 160 }}" alt="{{ value | escape }}" width="78" height="48" loading="lazy">
        {%- endif -%}
        <span class="plt-swatch__name">{{ value }}</span>
      </label>
    </span>
  {%- endfor -%}
</div>
