# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# If set, POST/PATCH/DELETE require header X-API-Key (WebSocket: ?api_key=)
FLAME_API_KEY=
FLAME_CORS_ORIGINS=http://localhost:5173
FLAME_MAX_UPLOAD_MB=500
FLAME_MAX_WORKERS=2
FLAME_RATE_LIMIT_PER_MINUTE=30
# Local development without Docker uses SQLite in ./storage by default:
# FLAME_DATABASE_URL=sqlite:///storage/flame.db
