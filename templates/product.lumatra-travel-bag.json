        "f1": {
          "type": "faq",
          "settings": {
            "question": "Does it Fit as a Carry-On?",
            "answer": "Yes! We've specifically designed the bag to fit as a carry-on on all airlines, including Spirit, United, Frontier, American, Delta, Southwest, Alaska and Hawaiian. Don't see your airline? Email us at support@lumatra.com and we'll confirm within 24 hours."
          }
        },
        "f2": {
          "type": "faq",
          "settings": {
            "question": "How Do Returns Work?",
            "answer": "We stand behind every Lumatra Travel Bag. If anything's not right, our 100-Day Guarantee has you covered — just reach us and we'll make it right. We respond personally within 24 hours."
          }
        },
        "f3": {
          "type": "faq",
          "settings": {
            "question": "How Much Clothing Can I Pack?",
            "answer": "You can comfortably pack up to 10 days' worth of everyday clothing, along with 2 to 3 wrinkle-free dresses, ensuring you're prepared for extended stays or varied occasions."
          }
        },
        "f4": {
          "type": "faq",
          "settings": {
            "question": "Is It Waterproof?",
            "answer": "Yes, it's crafted with a water-resistant PU leather exterior, ensuring your belongings stay dry and protected against rain or accidental spills."
          }
        },
        "f5": {
          "type": "faq",
          "settings": {
            "question": "What Is The Bag Made Of?",
            "answer": "Our Travel Bags are made out of super high-fiber PU leather. This is a form of vegan leather that is both sustainable and climate friendly."
          }
        },
        "f6": {
          "type": "faq",
          "settings": {
            "question": "Can this Bag Really Save me Money?",
            "answer": "The average cost of a checked bag for a round-trip flight ranges between $85–125. That means using the Lumatra travel bag (which classifies as a carry-on) essentially pays for itself on your first trip — and the bag is built to last 15-20 years."
          }
        }
      },
