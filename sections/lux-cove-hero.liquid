{{ 'lux-cove.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lux-cove.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign gallery_images = product.images
  if gallery_images.size == 0
    assign use_fallback = true
  endif
  assign compare_price = current_variant.compare_at_price
  assign show_compare = false
  if compare_price > current_variant.price
    assign show_compare = true
    assign save_pct = compare_price | minus: current_variant.price | times: 100.0 | divided_by: compare_price | round
  endif
  assign product_form_id = 'lc-product-form-' | append: section.id
-%}

<div class="lc-page" style="overflow:visible">
<section style="padding:24px 22px 40px" data-screen-label="Product">

  <div data-lc-gallery>
    {%- if use_fallback -%}
      <img data-lc-hero-img src="{{ 'lc-hero.jpg' | asset_url }}" class="lc-heroimg" alt="{{ product.title | escape }}">
    {%- else -%}
      <img data-lc-hero-img src="{{ gallery_images.first | image_url: width: 900 }}" class="lc-heroimg" alt="{{ product.title | escape }}">
    {%- endif -%}

    {%- if gallery_images.size > 1 -%}
      <div class="lc-thumbs">
        {%- for image in gallery_images limit: 6 -%}
          <img
            data-lc-thumb
            data-lc-full="{{ image | image_url: width: 900 }}"
            src="{{ image | image_url: width: 120 }}"
            class="lc-thumb{% if forloop.first %} lc-on{% endif %}"
            alt="{{ product.title | escape }} thumbnail {{ forloop.index }}">
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.eyebrow != blank -%}
    <div class="lc-eyebrow lc-mt16" style="text-align:center;width:100%">{{ section.settings.eyebrow }}</div>
  {%- endif -%}

  {%- if section.settings.show_rating -%}
    <div class="lc-fx lc-ac lc-gap8 lc-fs13 lc-mt12" style="justify-content:center">
      <span class="lc-stars">★★★★★</span>
      <span style="color:#6a5f54">{{ section.settings.rating_value }} / 5</span>
    </div>
  {%- endif -%}

  <h1 class="lc-serif" style="font-size:34px;font-weight:700;line-height:1.1;margin:10px 0 4px;text-align:center;letter-spacing:-.01em">{{ product.title }}</h1>

  <div class="lc-fx lc-ac lc-gap10 lc-mt12" style="justify-content:center">
    {%- if show_compare -%}
      <span class="lc-strike">{{ compare_price | money }}</span>
    {%- endif -%}
    <span class="lc-price">{{ current_variant.price | money }}</span>
    {%- if show_compare -%}
      <span class="lc-offpill">Save {{ save_pct }}%</span>
    {%- endif -%}
  </div>

  {%- if section.settings.stock_text != blank -%}
    <div class="lc-instock lc-mt12" style="justify-content:center"><span class="lc-gdot"></span>{{ section.settings.stock_text }}</div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="lc-col lc-gap12" style="margin-top:24px">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'benefit' -%}
            <div class="lc-benef" {{ block.shopify_attributes }}><span class="lc-pcheck">✓</span>{{ block.settings.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.review_quote != blank -%}
    <div class="lc-revcard" style="margin-top:22px">
      {%- if section.settings.review_image != blank -%}
        <img src="{{ section.settings.review_image | image_url: width: 100 }}" style="width:48px;height:48px;border-radius:10px;object-fit:cover;flex:none" alt="{{ section.settings.review_name | escape }}">
      {%- else -%}
        <img src="{{ 'lc-eleanor.jpg' | asset_url }}" style="width:48px;height:48px;border-radius:10px;object-fit:cover;flex:none" alt="{{ section.settings.review_name | escape }}">
      {%- endif -%}
      <div>
        <span class="lc-fw6">{{ section.settings.review_name }} <span class="lc-stars lc-fs12">★★★★★</span></span>
        <div style="margin-top:3px;font-style:italic">"{{ section.settings.review_quote }}"</div>
      </div>
    </div>
  {%- endif -%}

  {%- form 'product', product, id: product_form_id, data-lc-add-to-cart: '' -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}" data-lc-variant-id>

    {%- unless product.has_only_default_variant -%}
      <div class="lc-col lc-gap10" style="margin-top:20px">
        {%- for option in product.options_with_values -%}
          <div>
            <label class="lc-fs13 lc-fw6" style="display:block;margin-bottom:6px">{{ option.name }}</label>
            <select class="lc-nlin" data-lc-option-selector data-lc-option-position="{{ forloop.index0 }}" style="width:100%">
              {%- for value in option.values -%}
                <option value="{{ value | escape }}"{% if value == option.selected_value %} selected{% endif %}>{{ value }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endfor -%}
      </div>
      <script type="application/json" data-lc-variants>[
        {%- for variant in product.variants -%}
          {%- capture compare_price_str -%}{%- if variant.compare_at_price and variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money }}{%- endif -%}{%- endcapture -%}
          {
            "id": {{ variant.id }},
            "available": {{ variant.available }},
            "options": {{ variant.options | json }},
            "price": {{ variant.price | money | json }},
            "comparePrice": {{ compare_price_str | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]</script>
    {%- endunless -%}

    <button type="submit" class="lc-cta" style="margin-top:22px" data-lc-cta-button data-lc-add-label="Add to Cart · " {% unless current_variant.available %}disabled{% endunless %}>
      {%- if current_variant.available -%}
        Add to Cart · {{ current_variant.price | money }}
      {%- else -%}
        Sold Out
      {%- endif -%}
    </button>
  {%- endform -%}

  <div class="lc-fx" style="gap:8px;margin-top:22px">
    {%- for block in section.blocks -%}
      {%- if block.type == 'trust' -%}
        <div class="lc-trust" {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'shield' -%}
              <svg class="lc-ticon" viewBox="0 0 24 24"><circle cx="12" cy="10" r="7"></circle><path d="M9 10l2 2 4-4"></path><path d="M8 16l-1 5 5-2 5 2-1-5"></path></svg>
            {%- when 'truck' -%}
              <svg class="lc-ticon" viewBox="0 0 24 24"><rect x="2" y="7" width="13" height="10" rx="1"></rect><path d="M15 10h4l3 3v4h-7z"></path><circle cx="7" cy="19" r="1.6"></circle><circle cx="18" cy="19" r="1.6"></circle></svg>
            {%- else -%}
              <svg class="lc-ticon" viewBox="0 0 24 24"><circle cx="12" cy="9" r="6"></circle><path d="M9 14l-2 7 5-3 5 3-2-7"></path></svg>
          {%- endcase -%}
          {{ block.settings.label }}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.payment_image != blank -%}
    <img src="{{ section.settings.payment_image | image_url: width: 500 }}" style="width:82%;display:block;margin:22px auto 0;opacity:.85" alt="Payment methods">
  {%- else -%}
    <img src="{{ 'lc-pay.jpg' | asset_url }}" style="width:82%;display:block;margin:22px auto 0;opacity:.85" alt="Payment methods">
  {%- endif -%}

  {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
  {%- if accordion_blocks.size > 0 -%}
    <div style="margin-top:14px">
      {%- for block in accordion_blocks -%}
        <div class="lc-acc" {{ block.shopify_attributes }}>
          <button type="button" class="lc-acc-h" data-lc-toggle aria-expanded="false">
            <span>{{ block.settings.title }}</span>
            <span class="lc-chev" data-lc-chev>⌄</span>
          </button>
          <div class="lc-acc-b" data-lc-body hidden>{{ block.settings.body }}</div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>
</div>

<div class="lc-buybar">
  <div style="flex:none">
    <div class="lc-fs11" data-lc-buybar-compare style="color:#a89d90;text-decoration:line-through;line-height:1"{% unless show_compare %} hidden{% endunless %}>{{ compare_price | money }}</div>
    <div class="lc-price" style="font-size:22px;line-height:1.1" data-lc-buybar-price>{{ current_variant.price | money }}</div>
  </div>
  <button type="submit" form="{{ product_form_id }}" class="lc-cta lc-f1" data-lc-buybar-button {% unless current_variant.available %}disabled{% endunless %}>
    {%- if current_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
  </button>
</div>

{% schema %}
{
  "name": "Lux Cove: Product hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow badge", "default": "★ Bestseller · 150,000+ Sold" },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating", "default": true },
    { "type": "text", "id": "rating_value", "label": "Rating value", "default": "4.8" },
    { "type": "text", "id": "stock_text", "label": "Stock status text", "default": "In Stock · Ships Free Today" },
    { "type": "header", "content": "Featured review card" },
    { "type": "image_picker", "id": "review_image", "label": "Reviewer photo" },
    { "type": "text", "id": "review_name", "label": "Reviewer name", "default": "Eleanor T." },
    {
      "type": "textarea",
      "id": "review_quote",
      "label": "Review quote",
      "default": "I've tried every eye cream out there, but this is the only thing that actually made a difference. My dark circles have faded so much. This is now a staple in my routine!"
    },
    { "type": "header", "content": "Payment icons" },
    { "type": "image_picker", "id": "payment_image", "label": "Payment methods image" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Erase dark circles" }
      ]
    },
    {
      "type": "trust",
      "name": "Trust badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "shield", "label": "Shield / guarantee" },
          { "value": "truck", "label": "Shipping" },
          { "value": "star", "label": "Warranty" }
        ], "default": "shield" },
        { "type": "text", "id": "label", "label": "Label", "default": "90-Day Money-Back" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Product details" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Details go here." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lux Cove: Product hero",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Erase dark circles" } },
        { "type": "benefit", "settings": { "text": "Firm sagging under-eye bags" } },
        { "type": "benefit", "settings": { "text": "Get rid of under-eye wrinkles" } },
        { "type": "benefit", "settings": { "text": "Smooth out crow's feet" } },
        { "type": "benefit", "settings": { "text": "Clinically proven" } },
        { "type": "benefit", "settings": { "text": "Dermatologist approved" } },
        { "type": "trust", "settings": { "icon": "shield", "label": "90-Day Money-Back" } },
        { "type": "trust", "settings": { "icon": "truck", "label": "Free Shipping" } },
        { "type": "trust", "settings": { "icon": "star", "label": "1 Year Warranty" } },
        { "type": "accordion", "settings": { "title": "Product details", "body": "The Lux Cove Red Light Under-Eye Glasses are your at-home solution for youthful, refreshed eyes, without surgery, injections, or ineffective creams." } },
        { "type": "accordion", "settings": { "title": "Guarantee & warranty", "body": "We offer 90-day returns and a 1-year warranty on all purchases." } },
        { "type": "accordion", "settings": { "title": "Shipping & returns", "body": "United Kingdom: Express Tracked Shipping (3 - 5 Working Days) - FREE\nEU: Express Tracked Shipping (3 - 7 Working Days) - FREE\nUnited States: Express Tracked Shipping (3 - 7 Working Days) - FREE\nRest Of The World: Express Tracked Shipping (3 - 7 Working Days) - FREE" } }
      ]
    }
  ]
}
{% endschema %}
