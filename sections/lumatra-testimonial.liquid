{{ 'lumatra.css' | asset_url | stylesheet_tag }}
<div class="lm-page lm-panelbg">
  <div class="lm-sec" style="padding-top:44px;padding-bottom:44px">
    <div class="lm-sec-head">
      <span class="lm-eyebrow">{{ section.settings.eyebrow | default: 'Loved worldwide' }}</span>
      <h2 class="lm-sec-t">{{ section.settings.heading | default: "Over 100,000+ Women Can't Be Wrong..." }}</h2>
      <span class="lm-rule"></span>
    </div>
    {%- if section.blocks.size > 0 -%}
      <div style="overflow:hidden">
        <div class="lm-marquee-track" style="--lm-marquee-duration:{{ section.settings.speed | default: 60 }}s;">
          {%- for n in (1..2) -%}
            {%- for block in section.blocks -%}
              <div class="lm-pill" {{ block.shopify_attributes }}>
                <div class="lm-fx lm-ac lm-gap10">
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 80 }}" width="40" height="40" loading="lazy" class="lm-pillav" alt="{{ block.settings.name | escape }}">
                  {%- else -%}
                    <span class="lm-pillav-fallback">{{ block.settings.name | slice: 0 | upcase }}</span>
                  {%- endif -%}
                  <div><div class="lm-fw6 lm-fs13">{{ block.settings.name }}</div><div class="lm-stars lm-fs12">★★★★★</div></div>
                </div>
                <div style="font-style:italic">&ldquo;{{ block.settings.quote }}&rdquo;</div>
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Lumatra: Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved worldwide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Over 100,000+ Women Can't Be Wrong..." },
    { "type": "range", "id": "speed", "label": "Scroll duration (lower = faster)", "min": 20, "max": 120, "step": 5, "default": 60, "unit": "s" }
  ],
  "blocks": [
    { "type": "testimonial", "name": "Testimonial", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo (optional — falls back to initials)" },
      { "type": "text", "id": "name", "label": "Name", "default": "Customer name" },
      { "type": "textarea", "id": "quote", "label": "Quote" }
    ]}
  ],
  "presets": [
    {
      "name": "Lumatra: Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "Katherine Smith", "quote": "I used to dread dragging my luggage through airports, but with Lumatra, I just snap on the wheels, and it glides effortlessly." } },
        { "type": "testimonial", "settings": { "name": "Stephanie Luiz", "quote": "It fits all my essentials, including shoes for every occasion and outfits for a full week! Lumatra has given me back control over my packing." } },
        { "type": "testimonial", "settings": { "name": "Hannah Thompson", "quote": "The built-in hanger and anti-wrinkle lining in the Lumatra bag really work. Clothes stay wrinkle-free and ready to be worn!" } }
      ]
    }
  ]
}
{% endschema %}
