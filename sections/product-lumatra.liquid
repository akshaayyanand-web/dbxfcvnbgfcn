{%- comment -%}
  sections/product-lumatra.liquid
  Lumatra Travel Bag product page, converted from a static HTML/CSS/JS mockup into a native
  Shopify OS 2.0 section. Pairs with:
    assets/section-product-lumatra.css
    assets/section-product-lumatra.js
    snippets/icon-product-lumatra.liquid
    snippets/product-lumatra-gallery.liquid
    snippets/product-lumatra-swatch-picker.liquid
    snippets/product-lumatra-bundle-row.liquid
    snippets/product-lumatra-marquee.liquid
    snippets/product-lumatra-cart-drawer.liquid
    snippets/product-lumatra-model-modal.liquid
  See README-product-lumatra.md for installation, required/optional metafields, and assumptions.
{%- endcomment -%}

{{ 'section-product-lumatra.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&amp;family=Jost:wght@400;500;600&amp;display=swap" rel="stylesheet">

{%- liquid
  assign product = section.settings.product | default: product
  assign current_variant = product.selected_or_first_available_variant | default: product.variants.first

  assign primary_option_index = section.settings.primary_option_index | default: 1 | minus: 1
  if primary_option_index < 0
    assign primary_option_index = 0
  endif
  assign primary_option = product.options_with_values[primary_option_index] | default: product.options_with_values.first

  assign rating_value = section.settings.default_rating
  assign rating_count = section.settings.default_rating_count
  if product.metafields.reviews.rating.value
    assign rating_value = product.metafields.reviews.rating.value
  endif
  if product.metafields.reviews.rating_count.value
    assign rating_count = product.metafields.reviews.rating_count.value
  endif

  assign bundle_discount = section.settings.bundle_discount_percent | default: 30
  assign single_price = current_variant.price
  assign single_compare = current_variant.compare_at_price
  assign discount_keep = 100 | minus: bundle_discount
  assign double_price = single_price | times: 2 | times: discount_keep | divided_by: 100
  assign double_each = double_price | divided_by: 2
  assign double_compare = single_price | times: 2
  if single_compare and single_compare > single_price
    assign double_compare = single_compare | times: 2
  endif

  assign low_stock_threshold = section.settings.low_stock_threshold | default: 10
  assign show_low_stock = false
  if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= low_stock_threshold
    assign show_low_stock = true
  endif

  assign model_blocks = section.blocks | where: 'type', 'model_info'
  assign has_model_info = model_blocks.size > 0
-%}

<div class="plt" id="plt-{{ section.id }}" data-section-id="{{ section.id }}" data-primary-option-position="{{ primary_option.position | default: 1 }}">

  {%- render 'product-lumatra-marquee', text: section.settings.marquee_top_text, duration: 22 -%}

  <header class="plt-header">
    <div class="plt-header__row">
      <details class="plt-mobile-nav">
        <summary class="plt-header__hamburger" aria-label="Menu">
          {%- render 'icon-product-lumatra', icon: 'menu', width: 24, height: 18 -%}
        </summary>
        <div class="plt-mobile-nav__panel">
          {%- for block in section.blocks -%}
            {%- if block.type == 'nav_link' -%}
              <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </details>
      <span class="plt-header__spacer" aria-hidden="true"></span>

      <a href="{{ routes.root_url }}" class="plt-header__logo">{{ section.settings.logo_text | default: shop.name }}</a>

      <div class="plt-header__actions">
        <nav class="plt-header__nav" aria-label="Primary">
          {%- for block in section.blocks -%}
            {%- if block.type == 'nav_link' -%}
              <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
        <a href="{{ routes.account_url }}" class="plt-header__icon-btn" aria-label="Account">
          {%- render 'icon-product-lumatra', icon: 'account', width: 20, height: 22 -%}
        </a>
        <button type="button" class="plt-header__icon-btn" data-plt-cart-open aria-label="Open cart, {{ cart.item_count }} items">
          {%- render 'icon-product-lumatra', icon: 'cart', width: 20, height: 21 -%}
          <span class="plt-header__cart-count" data-plt-header-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </header>

  <div class="plt-hero">
    {%- render 'product-lumatra-gallery', product: product -%}

    <div class="plt-buybox">
      {%- form 'product', product, id: 'plt-product-form-' | append: section.id, class: 'plt-product-form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-plt-form-variant-id>
        <input type="hidden" name="quantity" value="1" data-plt-form-quantity>

        <div class="plt-badges">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_badge' -%}
              <div class="plt-badge" {{ block.shopify_attributes }}>
                {%- if block.settings.icon == 'plane' -%}{%- render 'icon-product-lumatra', icon: 'plane', width: 14, height: 14 -%}{%- endif -%}
                {{ block.settings.text }}
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if section.settings.show_new_badge_from_tag and product.tags contains section.settings.new_badge_tag -%}
            <div class="plt-badge">{{ section.settings.new_badge_text }}</div>
          {%- endif -%}
        </div>

        <div class="plt-rating">
          <span class="plt-rating__stars" aria-hidden="true">★★★★★</span>
          <a href="#plt-reviews-{{ section.id }}" class="plt-rating__link">{{ rating_count }} Reviews</a>
        </div>

        <h1 class="plt-title">{{ product.title }}</h1>
        {%- if section.settings.tagline != blank -%}
          <p class="plt-subtitle">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if primary_option -%}
          <div class="plt-model-row">
            <span class="plt-model-row__label">{{ section.settings.model_row_label | default: primary_option.name }}</span>
            {%- if has_model_info -%}
              <button type="button" class="plt-info-btn" data-plt-model-modal-open>
                {%- render 'icon-product-lumatra', icon: 'info', width: 14, height: 14 -%}
                {{ section.settings.model_info_cta | default: 'Which one is for me?' }}
              </button>
            {%- endif -%}
          </div>
          <div class="plt-model-current">{{ primary_option.name }}: <span data-plt-model-current-value>{{ current_variant.options[primary_option_index] }}</span></div>
          {%- render 'product-lumatra-swatch-picker', product: product, option: primary_option, selected_value: current_variant.options[primary_option_index], section: section -%}
        {%- endif -%}

        <div class="plt-sale-label">{{ section.settings.bundle_headline | default: 'Summer Sale: BOGO 30% Off + Fast Shipping' }}</div>

        <div class="plt-bundle" data-plt-bundle data-double-each="{{ double_each }}" data-single-price="{{ single_price }}" data-single-compare="{{ single_compare }}" data-double-price="{{ double_price }}" data-double-compare="{{ double_compare }}">
          <input class="plt-bundle__input plt-visually-hidden" type="radio" name="plt-bundle-{{ section.id }}" id="plt-bundle-single-{{ section.id }}" value="single" data-plt-bundle-radio>
          <label for="plt-bundle-single-{{ section.id }}" class="plt-bundle__option">
            <span class="plt-bundle__option-left">
              <span class="plt-bundle__radio-dot" aria-hidden="true"></span>
              <span>
                <span class="plt-bundle__option-title" style="display:block;">{{ section.settings.bundle_single_title | default: 'Buy 1' }}</span>
                <span class="plt-bundle__option-desc" style="display:block;">{{ section.settings.bundle_single_desc | default: 'The Ultimate Carry-On Bag' }}</span>
              </span>
            </span>
            <span class="plt-bundle__price-col">
              <span class="plt-bundle__price" data-plt-bundle-single-price>{{ single_price | money }}</span>
              <span class="plt-bundle__compare" data-plt-bundle-single-compare {% unless single_compare > single_price %}hidden{% endunless %}>{{ single_compare | money }}</span>
            </span>
          </label>

          <input class="plt-bundle__input plt-visually-hidden" type="radio" name="plt-bundle-{{ section.id }}" id="plt-bundle-double-{{ section.id }}" value="double" data-plt-bundle-radio checked>
          <div class="plt-bundle__group">
            <label for="plt-bundle-double-{{ section.id }}" class="plt-bundle__group-head">
              <span class="plt-bundle__option-left">
                <span class="plt-bundle__radio-dot" aria-hidden="true"></span>
                <span>
                  <span class="plt-bundle__option-title" style="display:block;">{{ section.settings.bundle_double_title | default: 'Buy 2 & Save' }} {{ bundle_discount }}%</span>
                  <span class="plt-bundle__option-desc" style="display:block;">{{ section.settings.bundle_double_desc | default: 'Match Bags With Your Partner' }}</span>
                </span>
              </span>
              <span class="plt-bundle__price-col">
                <span class="plt-bundle__price" data-plt-bundle-double-price>{{ double_price | money }}</span>
                <span class="plt-bundle__compare" data-plt-bundle-double-compare>{{ double_compare | money }}</span>
              </span>
            </label>
            <div class="plt-bundle__flash-wrap">
              <span class="plt-bundle__flash">{{ section.settings.bundle_flash_label | default: 'FLASH SALE' }} - <span data-plt-bundle-each>{{ double_each | money }}</span> EACH</span>
            </div>
            <div class="plt-bundle__rows">
              {%- render 'product-lumatra-bundle-row', product: product, bag: 1 -%}
              {%- render 'product-lumatra-bundle-row', product: product, bag: 2 -%}
            </div>
          </div>
        </div>

        {%- if product.selling_plan_groups.size > 0 -%}
          <div class="plt-selling-plans" data-plt-selling-plans>
            {%- for group in product.selling_plan_groups -%}
              <label class="plt-model-row__label" for="plt-selling-plan-{{ group.id }}-{{ section.id }}">{{ group.name }}</label>
              <select id="plt-selling-plan-{{ group.id }}-{{ section.id }}" name="selling_plan" class="plt-bundle__row-select" data-plt-selling-plan-select>
                <option value="">{{ section.settings.one_time_purchase_label | default: 'One-time purchase' }}</option>
                {%- for allocation in group.selling_plan_allocations -%}
                  <option value="{{ allocation.selling_plan.id }}">{{ allocation.selling_plan.name }}</option>
                {%- endfor -%}
              </select>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <button type="submit" class="plt-atc" data-plt-atc {% unless current_variant.available %}disabled{% endunless %}>
          <div class="plt-atc__line" data-plt-atc-available-line {% unless current_variant.available %}hidden{% endunless %}>{{ section.settings.atc_label | default: 'ADD TO CART' }} - <span class="plt-atc__was" data-plt-atc-compare>{{ double_compare | money }}</span> <span data-plt-atc-price>{{ double_price | money }}</span></div>
          <div class="plt-atc__sub" data-plt-atc-sub {% unless current_variant.available %}hidden{% endunless %}>{{ section.settings.atc_sub_label | default: 'In-Stock: Ready To Ship' }}</div>
          <div class="plt-atc__line" data-plt-atc-soldout-line {% if current_variant.available %}hidden{% endif %}>{{ section.settings.sold_out_label | default: 'Sold Out' }}</div>
        </button>

        {%- if section.settings.show_dynamic_checkout and current_variant.available -%}
          <div class="plt-dynamic-checkout">{{ form | payment_button }}</div>
        {%- endif -%}
      {%- endform -%}

      <div class="plt-stock-warning" data-plt-stock-warning {% unless show_low_stock %}hidden{% endunless %}>
        <span class="plt-pulse-dot" aria-hidden="true"></span>
        <span class="plt-stock-warning__text">{{ section.settings.low_stock_text | default: 'Warning: Low Stock Remaining' }}</span>
      </div>
      <div data-plt-sentinel class="plt-sentinel"></div>

      {%- assign video_blocks = section.blocks | where: 'type', 'video_showcase' -%}
      {%- if video_blocks.size > 0 -%}
        <div class="plt-videos-block">
          <div class="plt-block-label">{{ section.settings.videos_heading | default: 'See the Lumatra Bag in Action' }}</div>
          <div class="plt-videos">
            {%- for block in video_blocks -%}
              {%- liquid
                assign video_img_url = blank
                if block.settings.image
                  assign video_img_url = block.settings.image | image_url: width: 260
                else
                  case block.settings.label
                    when 'Why Women Love This Design'
                      assign video_img_url = 'product-lumatra-video-a.png' | asset_url
                    when 'Why This Is My Go-To Travel Bag'
                      assign video_img_url = 'product-lumatra-video-b.png' | asset_url
                    when 'How to Pack Like a Pro'
                      assign video_img_url = 'product-lumatra-video-c.png' | asset_url
                  endcase
                endif
              -%}
              <div class="plt-video-card" {{ block.shopify_attributes }}>
                <div class="plt-video-card__thumb">
                  {%- if video_img_url != blank -%}
                    <img src="{{ video_img_url }}" alt="{{ block.settings.label | escape }}" width="130" height="164" loading="lazy">
                  {%- endif -%}
                  <span class="plt-video-card__play" aria-hidden="true">
                    <svg width="34" height="34" viewBox="0 0 34 34" fill="none"><circle cx="17" cy="17" r="16" fill="#fff" fill-opacity=".92"/><path d="M14 11L24 17L14 23V11Z" fill="#2B2320"/></svg>
                  </span>
                </div>
                <div class="plt-video-card__label">{{ block.settings.label }}</div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- assign checklist_items = section.settings.checklist_text | newline_to_br | strip_newlines | split: '<br />' -%}
      {%- if checklist_items.size > 0 -%}
        <div class="plt-checklist-block">
          <div class="plt-block-label" style="text-transform:none;">{{ section.settings.checklist_heading | default: 'Why Women Love It:' }}</div>
          <ul class="plt-checklist">
            {%- for line in checklist_items -%}
              {%- assign trimmed_line = line | strip -%}
              {%- if trimmed_line != blank -%}
                <li class="plt-checklist__item">
                  <span class="plt-checklist__icon">{%- render 'icon-product-lumatra', icon: 'check', width: 10, height: 8, stroke: '#fff' -%}</span>
                  <span class="plt-checklist__text">{{ trimmed_line }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="plt-trust-block">
        <div class="plt-trust-row">
          {%- render 'icon-product-lumatra', icon: 'truck-wheels', width: 22, height: 22, stroke_width: 1.3 -%}
          <div>
            <div class="plt-trust-row__title">{{ section.settings.trust_1_title | default: '100,000+ Happy Customers' }}</div>
            <div class="plt-trust-row__text">{{ section.settings.trust_1_text | default: 'Join thousands who take their Lumatra on every trip' }}</div>
          </div>
        </div>
        <div class="plt-trust-row">
          {%- render 'icon-product-lumatra', icon: 'shield', width: 22, height: 22, stroke_width: 1.3 -%}
          <div>
            <div class="plt-trust-row__title">{{ section.settings.trust_2_title | default: '100-Day Guarantee' }}</div>
            <div class="plt-trust-row__text">{{ section.settings.trust_2_text | default: "We stand behind every Lumatra bag — if it's not right, we'll make it right." }}</div>
          </div>
        </div>

        {%- assign airline_blocks = section.blocks | where: 'type', 'airline_logo' -%}
        {%- if airline_blocks.size > 0 -%}
          <details class="plt-airlines">
            <summary class="plt-airlines-toggle">
              {%- render 'icon-product-lumatra', icon: 'info', width: 15, height: 15 -%}
              {{ section.settings.airlines_cta | default: 'See list of approved airlines' }}
            </summary>
            <div class="plt-airlines-panel">
              {%- assign airline_names = section.settings.airline_names | newline_to_br | strip_newlines | split: '<br />' -%}
              {%- for name in airline_names -%}
                {%- assign trimmed_name = name | strip -%}
                {%- if trimmed_name != blank -%}<span class="plt-airline-chip">{{ trimmed_name }}</span>{%- endif -%}
              {%- endfor -%}
            </div>
          </details>
        {%- endif -%}
      </div>

      <div class="plt-savings-card">
        <div class="plt-savings-card__title">{{ section.settings.savings_title_pre | default: 'Save' }} <strong>{{ section.settings.savings_title_strong | default: 'BIG' }}</strong> {{ section.settings.savings_title_post | default: 'on Every Trip' }}</div>
        <div class="plt-savings-card__text">{{ section.settings.savings_text | default: 'Why pay extra luggage fees? With the Lumatra Bag, you can skip the check-in line and keep your travel budget intact.' }}</div>
        <div class="plt-savings-card__row">
          <span class="plt-savings-card__brand">{{ shop.name }}</span>
          <span class="plt-savings-card__value">{{ section.settings.savings_us_value | default: '$0 In Luggage Fees' }}</span>
        </div>
        <div class="plt-savings-card__row--alt">
          <span class="plt-savings-card__pill">{{ section.settings.savings_them_label | default: 'Checked Bag Fees (Per Trip)' }}</span>
          <span class="plt-savings-card__value">{{ section.settings.savings_them_value | default: '$65+ Per Trip' }}</span>
        </div>
        <div class="plt-savings-card__footnote">{{ section.settings.savings_footnote | default: '*Annual Cost for 5 trips | $325+ saved' }}</div>
      </div>

      <div class="plt-tabs-wrap" data-plt-tabs>
        <input class="plt-tab-input" type="radio" name="plt-tabtoggle-{{ section.id }}" id="plt-tab-details-{{ section.id }}" checked>
        <input class="plt-tab-input" type="radio" name="plt-tabtoggle-{{ section.id }}" id="plt-tab-included-{{ section.id }}">
        <input class="plt-tab-input" type="radio" name="plt-tabtoggle-{{ section.id }}" id="plt-tab-shipping-{{ section.id }}">
        <div class="plt-tabs">
          <label class="plt-tab-label" for="plt-tab-details-{{ section.id }}">{{ section.settings.tab_details_label | default: 'Details' }}</label>
          <label class="plt-tab-label" for="plt-tab-included-{{ section.id }}">{{ section.settings.tab_included_label | default: "What's Included" }}</label>
          <label class="plt-tab-label" for="plt-tab-shipping-{{ section.id }}">{{ section.settings.tab_shipping_label | default: 'Shipping | Returns' }}</label>
        </div>
        <div class="plt-tab-panels">
          <div class="plt-tab-panel">
            {%- if product.description != blank -%}
              <div class="plt-shipping-copy">{{ product.description }}</div>
            {%- endif -%}
            <div class="plt-block-label" style="text-transform:uppercase;">{{ section.settings.details_heading | default: 'What Makes It Great:' }}</div>
            <div class="plt-feature-grid">
              {%- assign great_items = section.settings.what_makes_great | newline_to_br | strip_newlines | split: '<br />' -%}
              {%- for line in great_items -%}
                {%- assign trimmed_great = line | strip -%}
                {%- if trimmed_great != blank -%}
                  <div class="plt-feature-grid__item">
                    <span class="plt-feature-grid__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="8" width="16" height="13" rx="2" stroke="#2B2320" stroke-width="1.3"/><path d="M9 8V5C9 3.5 10.5 2 12 2C13.5 2 15 3.5 15 5V8" stroke="#2B2320" stroke-width="1.3"/></svg></span>
                    <span class="plt-feature-grid__text">{{ trimmed_great }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="plt-block-label" style="text-transform:uppercase;">{{ section.settings.other_details_heading | default: 'Other Details:' }}</div>
            <ul class="plt-detail-list">
              {{ section.settings.other_details }}
              {%- if current_variant.sku != blank -%}<li><strong>SKU:</strong> {{ current_variant.sku }}</li>{%- endif -%}
            </ul>
          </div>
          <div class="plt-tab-panel">
            <div class="plt-included-intro">{{ section.settings.included_intro | default: 'For every Lumatra Travel Bag ordered, you\'ll receive:' }}</div>
            <ul class="plt-included-list">{{ section.settings.included_list }}</ul>
            <div class="plt-included-free">{{ section.settings.included_footer | default: 'All for free!' }}</div>
          </div>
          <div class="plt-tab-panel">{{ section.settings.shipping_copy }}</div>
        </div>
      </div>
    </div>
  </div>

  {%- render 'product-lumatra-marquee', text: section.settings.marquee_sale_text, duration: 16, variant_class: 'plt-marquee--sale' -%}

  <div class="plt-container--md">
    <div class="plt-panel-card">
      <div class="plt-panel-card__head">
        <h2 class="plt-h2 plt-h2--sm">{{ section.settings.features_heading_bold | default: '3 Features' }} <span style="font-weight:400;">{{ section.settings.features_heading_light | default: 'only women would think to include (seriously)' }}</span></h2>
        <div class="plt-panel-card__head-rating">
          <span class="plt-rating__stars" style="color:var(--plt-ink);" aria-hidden="true">★★★★★</span>
          <span class="plt-rating-count">{{ rating_value }} ({{ rating_count }} reviews)</span>
        </div>
      </div>
      <div class="plt-features3">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature_highlight' -%}
            {%- liquid
              assign feature_img_url = blank
              if block.settings.image
                assign feature_img_url = block.settings.image | image_url: width: 640
              else
                case block.settings.title
                  when "Wheels when you need them, straps when you don't"
                    assign feature_img_url = 'product-lumatra-feat-wheels.png' | asset_url
                  when 'Your Clothes, Always Wrinkle-Free (no exaggeration)'
                    assign feature_img_url = 'product-lumatra-feat-clothes.png' | asset_url
                  when 'Fits in Overhead Bins, No Luggage Fees'
                    assign feature_img_url = 'product-lumatra-feat-dims.png' | asset_url
                endcase
              endif
            -%}
            <div class="plt-feature-card" {{ block.shopify_attributes }}>
              <div class="plt-feature-card__img">
                {%- if feature_img_url != blank -%}
                  <img src="{{ feature_img_url }}" alt="{{ block.settings.title | escape }}" width="640" height="538" loading="lazy">
                {%- endif -%}
              </div>
              {%- if block.settings.badge != blank -%}
                <span class="plt-feature-card__badge">{{ block.settings.badge }}</span>
              {%- endif -%}
              <div class="plt-feature-card__title">{{ block.settings.title }}</div>
              <div class="plt-feature-card__text">{{ block.settings.text }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="plt-press-section">
      <h2 class="plt-h2 plt-h2--responsive">{{ section.settings.press_heading | default: 'Trusted By Top Rated Travel Companies Worldwide' }}</h2>
      <div class="plt-rating">
        <span class="plt-rating__stars" aria-hidden="true">★★★★★</span>
        <span class="plt-rating-copy">Rated {{ rating_value }}/5 based on {{ rating_count }}+</span>
      </div>
      <div class="plt-press-divider">
        <span class="plt-press-divider__line"></span>
        <span class="plt-press-divider__label">{{ section.settings.press_label | default: 'AS SEEN IN' }}</span>
        <span class="plt-press-divider__line"></span>
      </div>
      <div class="plt-press-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'press_quote' -%}
            <div class="plt-press-card" {{ block.shopify_attributes }}>
              <p class="plt-press-card__quote">&ldquo;{{ block.settings.text }}&rdquo;</p>
              {%- case block.settings.badge_style -%}
