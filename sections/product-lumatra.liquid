                  <svg class="plt-promise-item__icon" width="24" height="26" viewBox="0 0 24 26" fill="none" aria-hidden="true"><path d="M12 1L22 4.5V11C22 17 17.5 21.5 12 24C6.5 21.5 2 17 2 11V4.5L12 1Z" stroke="#2B2320" stroke-width="1.3"/><path d="M7 13L10.5 16.5L17 9" stroke="#2B2320" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- else -%}
                  <svg class="plt-promise-item__icon" width="30" height="24" viewBox="0 0 30 24" fill="none" aria-hidden="true"><path d="M1 5H19V19H1V5Z" stroke="#2B2320" stroke-width="1.3"/><path d="M19 10H24L28 15V19H19V10Z" stroke="#2B2320" stroke-width="1.3"/><circle cx="8" cy="21" r="2.4" stroke="#2B2320" stroke-width="1.3"/><circle cx="23" cy="21" r="2.4" stroke="#2B2320" stroke-width="1.3"/></svg>
              {%- endcase -%}
              <div class="plt-promise-item__title">{{ block.settings.title }}</div>
              <div class="plt-promise-item__text">{{ block.settings.text }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
  <div id="plt-reviews-{{ section.id }}" class="plt-reviews-section">
    <div class="plt-reviews-summary">
      <div class="plt-reviews-summary__score">
        <div class="plt-reviews-summary__number">{{ rating_value }}</div>
        <div class="plt-reviews-summary__stars" aria-hidden="true">★★★★★</div>
        <div class="plt-reviews-summary__count">{{ rating_count }} reviews</div>
      </div>
      <div class="plt-histogram">
        {%- liquid
          assign h5 = section.settings.rating_5_count
          assign h4 = section.settings.rating_4_count
          assign h3 = section.settings.rating_3_count
          assign h2c = section.settings.rating_2_count
          assign h1 = section.settings.rating_1_count
          assign histogram_total = h5 | plus: h4 | plus: h3 | plus: h2c | plus: h1
          if histogram_total == 0
            assign histogram_total = 1
          endif
        -%}
        {%- for pair in '5,4,3,2,1' | split: ',' -%}
          {%- case pair -%}
            {%- when '5' -%}{%- assign star_count = h5 -%}
            {%- when '4' -%}{%- assign star_count = h4 -%}
            {%- when '3' -%}{%- assign star_count = h3 -%}
            {%- when '2' -%}{%- assign star_count = h2c -%}
            {%- when '1' -%}{%- assign star_count = h1 -%}
          {%- endcase -%}
          {%- assign star_pct = star_count | times: 100 | divided_by: histogram_total -%}
          <div class="plt-histogram__row">
            <span class="plt-histogram__label">{{ pair }} ★</span>
            <div class="plt-histogram__track"><div class="plt-histogram__fill" style="width:{{ star_pct }}%;"></div></div>
            <span class="plt-histogram__count">({{ star_count }})</span>
          </div>
        {%- endfor -%}
      </div>
      <div class="plt-reviews-summary__cta">
        <div class="plt-reviews-summary__cta-label">{{ section.settings.write_review_label | default: 'Share your experience' }}</div>
        <span class="plt-rating__stars" aria-hidden="true">★★★★★</span>
        <button type="button" class="plt-write-review-btn">{{ section.settings.write_review_button | default: 'Write a Review' }}</button>
      </div>
    </div>

    {%- if review_blocks.size > 0 -%}
      <input type="checkbox" id="plt-reviews-toggle-{{ section.id }}" class="plt-visually-hidden plt-reviews-checkbox" data-plt-reviews-checkbox>
      <div class="plt-review-grid">
        {%- for block in review_blocks -%}
          {%- liquid
            assign review_img_url = blank
            if block.settings.image
              assign review_img_url = block.settings.image | image_url: width: 460
            else
              case block.settings.name
                when 'Aria P.'
                  assign review_img_url = 'product-lumatra-review-aria.png' | asset_url
                when 'Stacy P.'
                  assign review_img_url = 'product-lumatra-review-stacy.png' | asset_url
                when 'Mariah C.'
                  assign review_img_url = 'product-lumatra-review-mariah.png' | asset_url
                when 'Polly F.'
                  assign review_img_url = 'product-lumatra-review-polly.png' | asset_url
                when 'Jennifer H.'
                  assign review_img_url = 'product-lumatra-review-jennifer.png' | asset_url
              endcase
            endif
          -%}
          <div class="plt-review-card{% if forloop.index > 8 %} plt-reviews-more{% endif %}" {{ block.shopify_attributes }}>
            {%- if review_img_url != blank -%}
              <img src="{{ review_img_url }}" alt="{{ block.settings.name | escape }} review photo" width="460" height="340" loading="lazy">
            {%- endif -%}
            <div class="plt-review-card__body">
              <div class="plt-review-card__name">{{ block.settings.name }}</div>
              <div class="plt-review-card__stars" aria-hidden="true">★★★★★</div>
              <div class="plt-review-card__text">{{ block.settings.text }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- if review_blocks.size > 8 -%}
        <label for="plt-reviews-toggle-{{ section.id }}" class="plt-reviews-toggle-wrap">
          <span class="plt-reviews-toggle">
            <span class="plt-reviews-toggle__more">{{ section.settings.reviews_more_label | default: 'See more reviews' }}</span>
            <span class="plt-reviews-toggle__less">{{ section.settings.reviews_less_label | default: 'Show fewer reviews' }}</span>
          </span>
        </label>
      {%- endif -%}
    {%- endif -%}
  </div>

  <footer class="plt-footer">
    <div class="plt-footer__cols">
      <div>
        <div class="plt-footer__brand">{{ section.settings.logo_text | default: shop.name }}</div>
        <p class="plt-footer__tagline">{{ section.settings.footer_tagline | default: 'Pack smarter, travel lighter, and skip the luggage fees—all in style.' }}</p>
      </div>
      <div>
        <div class="plt-footer__heading">{{ section.settings.footer_menu_heading | default: 'Main menu' }}</div>
        <div class="plt-footer__links">
          {%- for block in section.blocks -%}
            {%- if block.type == 'nav_link' -%}
              <a href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div>
        <div class="plt-footer__heading">{{ section.settings.footer_policies_heading | default: 'Policies' }}</div>
        <div class="plt-footer__links">
          {%- if shop.privacy_policy.url -%}<a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>{%- endif -%}
          {%- if shop.refund_policy.url -%}<a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{%- endif -%}
          {%- if shop.shipping_policy.url -%}<a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>{%- endif -%}
          {%- if shop.terms_of_service.url -%}<a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>{%- endif -%}
          {%- if shop.subscription_policy.url -%}<a href="{{ shop.subscription_policy.url }}">{{ shop.subscription_policy.title }}</a>{%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'footer_policy_link' -%}
              <a href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div>
        <div class="plt-footer__heading">{{ section.settings.footer_region_heading | default: 'Region' }}</div>
        <div class="plt-footer__region-line">{{ localization.country.name | default: 'United States' }} ({{ cart.currency.symbol | default: '$' }}{{ cart.currency.iso_code | default: 'USD' }})</div>
        <div class="plt-footer__region-line" style="margin-bottom:0;">{{ localization.language.endonym_name | default: 'English' | capitalize }}</div>
      </div>
    </div>
    <div class="plt-footer__bottom">
      <div class="plt-footer__copyright">&copy; {{ 'now' | date: '%Y' }}, {{ shop.name }}</div>
      <div class="plt-footer__payments">
        {%- for type in shop.enabled_payment_types -%}
          <span class="plt-footer__payment">{{ type | payment_type_svg_tag }}</span>
        {%- endfor -%}
      </div>
    </div>
  </footer>

  <div class="plt-sticky-atc" data-plt-sticky-atc>
    <div class="plt-sticky-atc__thumb">
      {%- if current_variant.featured_image -%}
        <img src="{{ current_variant.featured_image | image_url: width: 88 }}" alt="" width="44" height="44" loading="lazy" data-plt-sticky-thumb>
      {%- elsif product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 88 }}" alt="" width="44" height="44" loading="lazy" data-plt-sticky-thumb>
      {%- endif -%}
    </div>
    <div class="plt-sticky-atc__info">
      <div class="plt-sticky-atc__title">{{ product.title }}</div>
      <div class="plt-sticky-atc__price">
        <span data-plt-sticky-price>{{ double_price | money }}</span> <span class="plt-sticky-atc__compare" data-plt-sticky-compare>{{ double_compare | money }}</span>
      </div>
    </div>
    <button type="button" class="plt-sticky-atc__btn" data-plt-quick-add>{{ section.settings.sticky_atc_label | default: 'Add to Cart' }}</button>
  </div>

  {%- render 'product-lumatra-cart-drawer', section: section -%}
  {%- render 'product-lumatra-model-modal', section: section -%}

  <script type="application/json" data-plt-config>
    {
      "sectionId": {{ section.id | json }},
      "variants": {{ product.variants | json | replace: '</script', '<\/script' }},
      "primaryOptionPosition": {{ primary_option.position | default: 1 }},
      "optionCount": {{ product.options.size }},
      "cartAddUrl": {{ routes.cart_add_url | json }},
      "cartChangeUrl": {{ routes.cart_change_url | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "bundleDiscountPercent": {{ bundle_discount | json }},
      "lowStockThreshold": {{ low_stock_threshold | json }},
      "productFeaturedImage": {{ product.featured_image | image_url: width: 200 | json }},
      "labels": {
        "addToCart": {{ section.settings.atc_label | default: 'ADD TO CART' | json }},
        "soldOut": {{ section.settings.sold_out_label | default: 'Sold Out' | json }},
        "unavailable": {{ section.settings.unavailable_label | default: 'Unavailable' | json }},
        "inStock": {{ section.settings.atc_sub_label | default: 'In-Stock: Ready To Ship' | json }}
      }
    }
  </script>
</div>

<script src="{{ 'section-product-lumatra.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Lumatra product page",
  "tag": "section",
  "class": "shopify-section--product-lumatra",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Product", "info": "Defaults to the product on the current page. Only set this to feature a different product." },
    { "type": "range", "id": "primary_option_index", "label": "Swatch-picker option position", "min": 1, "max": 3, "step": 1, "default": 1, "info": "Which product option (1st, 2nd or 3rd) is shown as image swatches in the hero. Other options appear as dropdowns inside the Buy 2 rows." },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Lumatra" },
    { "type": "text", "id": "tagline", "label": "Tagline (short subtitle under the title)", "default": "Pack smarter, travel lighter, and skip the luggage fees—all in style" },
    { "type": "text", "id": "default_rating", "label": "Fallback average rating", "default": "4.7", "info": "Used only if product.metafields.reviews.rating is empty." },
    { "type": "text", "id": "default_rating_count", "label": "Fallback review count", "default": "1346", "info": "Used only if product.metafields.reviews.rating_count is empty." },

    { "type": "header", "content": "Navigation" },
    { "type": "checkbox", "id": "show_new_badge_from_tag", "label": "Show a badge automatically when the product has a tag", "default": true },
    { "type": "text", "id": "new_badge_tag", "label": "Tag that triggers the badge", "default": "new" },
    { "type": "text", "id": "new_badge_text", "label": "Badge text", "default": "NEW ARRIVAL" },

    { "type": "header", "content": "Model / style picker" },
    { "type": "text", "id": "model_row_label", "label": "Row label override", "info": "Leave blank to use the option name (e.g. \"Style\")." },
    { "type": "text", "id": "model_info_cta", "label": "\"Compare models\" button label", "default": "Which one is for me?" },
    { "type": "text", "id": "model_modal_title", "label": "Compare modal title", "default": "Classic vs. Roller Edition" },

    { "type": "header", "content": "Bundle / bulk pricing" },
    { "type": "paragraph", "content": "Prices are calculated from the product's real price and compare-at price — nothing here is a fixed dollar amount." },
    { "type": "text", "id": "bundle_headline", "label": "Bundle section headline", "default": "Summer Sale: BOGO 30% Off + Fast Shipping" },
    { "type": "range", "id": "bundle_discount_percent", "label": "\"Buy 2\" discount", "min": 0, "max": 70, "step": 5, "default": 30, "unit": "%" },
    { "type": "text", "id": "bundle_single_title", "label": "Single option title", "default": "Buy 1" },
    { "type": "text", "id": "bundle_single_desc", "label": "Single option description", "default": "The Ultimate Carry-On Bag" },
    { "type": "text", "id": "bundle_double_title", "label": "Double option title (% appended automatically)", "default": "Buy 2 & Save" },
    { "type": "text", "id": "bundle_double_desc", "label": "Double option description", "default": "Match Bags With Your Partner" },
    { "type": "text", "id": "bundle_flash_label", "label": "Flash sale badge prefix", "default": "FLASH SALE" },

    { "type": "header", "content": "Add to cart" },
    { "type": "text", "id": "atc_label", "label": "Add-to-cart button label", "default": "ADD TO CART" },
    { "type": "text", "id": "atc_sub_label", "label": "Add-to-cart helper text", "default": "In-Stock: Ready To Ship" },
    { "type": "text", "id": "sold_out_label", "label": "Sold-out button label", "default": "Sold Out" },
    { "type": "text", "id": "unavailable_label", "label": "Unavailable selection message", "default": "Unavailable" },
    { "type": "text", "id": "one_time_purchase_label", "label": "Selling-plan \"one-time purchase\" option label", "default": "One-time purchase" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button (Shop Pay / PayPal / etc.)", "default": true },
    { "type": "number", "id": "low_stock_threshold", "label": "Low-stock warning threshold", "default": 10, "info": "Shown only when Shopify inventory tracking is on and stock is at or below this number." },
    { "type": "text", "id": "low_stock_text", "label": "Low-stock warning text", "default": "Warning: Low Stock Remaining" },
    { "type": "text", "id": "sticky_atc_label", "label": "Sticky bar button label", "default": "Add to Cart" },
    { "type": "text", "id": "cta_label", "label": "\"Configure Your Bag\" CTA label (used across the page)", "default": "Configure Your Bag" },

    { "type": "header", "content": "Video showcase heading" },
    { "type": "text", "id": "videos_heading", "label": "Heading", "default": "See the Lumatra Bag in Action" },

    { "type": "header", "content": "\"Why women love it\" checklist" },
    { "type": "text", "id": "checklist_heading", "label": "Heading", "default": "Why Women Love It:" },
    { "type": "textarea", "id": "checklist_text", "label": "One item per line", "default": "Holds 38+ Items of Clothing, Plus 5 Pairs of Shoes\nSwitch Between Shoulder & Rolling in Seconds\nWrinkle-Free Packing for Any Outfit\nSkip the Check-in Line & save up to $65 on fees" },

    { "type": "header", "content": "Trust rows" },
    { "type": "text", "id": "trust_1_title", "label": "Row 1 title", "default": "100,000+ Happy Customers" },
    { "type": "text", "id": "trust_1_text", "label": "Row 1 text", "default": "Join thousands who take their Lumatra on every trip" },
    { "type": "text", "id": "trust_2_title", "label": "Row 2 title", "default": "100-Day Guarantee" },
    { "type": "text", "id": "trust_2_text", "label": "Row 2 text", "default": "We stand behind every Lumatra bag — if it's not right, we'll make it right." },
    { "type": "text", "id": "airlines_cta", "label": "\"See approved airlines\" toggle label", "default": "See list of approved airlines" },
    { "type": "textarea", "id": "airline_names", "label": "Approved airlines (one per line)", "default": "Spirit\nUnited\nFrontier\nAmerican\nDelta\nSouthwest\nAlaska\nJetBlue\nHawaiian\nAllegiant" },

    { "type": "header", "content": "Savings calculator card" },
    { "type": "text", "id": "savings_title_pre", "label": "Title (before emphasis)", "default": "Save" },
    { "type": "text", "id": "savings_title_strong", "label": "Title (emphasized word)", "default": "BIG" },
    { "type": "text", "id": "savings_title_post", "label": "Title (after emphasis)", "default": "on Every Trip" },
    { "type": "textarea", "id": "savings_text", "label": "Body copy", "default": "Why pay extra luggage fees? With the Lumatra Bag, you can skip the check-in line and keep your travel budget intact." },
    { "type": "text", "id": "savings_us_value", "label": "Your brand's value", "default": "$0 In Luggage Fees" },
    { "type": "text", "id": "savings_them_label", "label": "Comparison pill label", "default": "Checked Bag Fees (Per Trip)" },
    { "type": "text", "id": "savings_them_value", "label": "Comparison value", "default": "$65+ Per Trip" },
    { "type": "text", "id": "savings_footnote", "label": "Footnote", "default": "*Annual Cost for 5 trips | $325+ saved" },

    { "type": "header", "content": "Tabs" },
    { "type": "text", "id": "tab_details_label", "label": "Tab 1 label", "default": "Details" },
    { "type": "text", "id": "tab_included_label", "label": "Tab 2 label", "default": "What's Included" },
    { "type": "text", "id": "tab_shipping_label", "label": "Tab 3 label", "default": "Shipping | Returns" },
    { "type": "text", "id": "details_heading", "label": "Details: grid heading", "default": "What Makes It Great:" },
    { "type": "textarea", "id": "what_makes_great", "label": "Details: grid items (one per line)", "default": "Space for Every Outfit, Plus Extras\nWrinkle-Free Packing System\nDetachable Wheels Option Available\nDedicated Shoe Compartment\nMulti-pockets for Make-up\nAirline-Approved Carry-On Size" },
    { "type": "text", "id": "other_details_heading", "label": "Details: list heading", "default": "Other Details:" },
    { "type": "textarea", "id": "other_details", "label": "Details: list (raw <li> HTML, one per line)", "default": "<li><strong>TSA</strong> Carry-on Approved Size</li>\n<li><strong>Material:</strong> Premium, eco-friendly PU leather</li>\n<li><strong>Water-Resistant Coating:</strong> Protects against spills and light rain</li>\n<li><strong>Weight:</strong> 2.2 lbs (1.1 kg)</li>\n<li><strong>Dimensions:</strong> 20\" x 9\" x 12.5\" (carry-on approved)</li>\n<li><strong>Non Slip Zippers</strong></li>" },
    { "type": "text", "id": "included_intro", "label": "Included: intro text", "default": "For every Lumatra Travel Bag ordered, you'll receive:" },
    { "type": "textarea", "id": "included_list", "label": "Included: list (raw <li> HTML, one per line)", "default": "<li>1x Padded Shoulder Strap</li>\n<li>1x Toiletry/Shoe Bag</li>\n<li>1x Travel Guide (82 Pages)</li>\n<li>100-Day Return Guarantee</li>\n<li>24/7 Customer Support</li>" },
    { "type": "text", "id": "included_footer", "label": "Included: footer line", "default": "All for free!" },
    { "type": "richtext", "id": "shipping_copy", "label": "Shipping & returns copy", "default": "<p>All Lumatra orders are fulfilled and shipped to anywhere in the United States in <strong>4-6 working days</strong> on average.</p><p>Worldwide shipping (other than US) takes <strong>5-10 working days</strong> depending on location.</p><p>All orders come with tracking information once shipped.</p>" },

    { "type": "header", "content": "Marquee strips" },
    { "type": "textarea", "id": "marquee_top_text", "label": "Top marquee (one item per line)", "default": "Up to 60% Off\nOver 100,000+ Sold\nUp to 60% Off\nOver 100,000+ Sold\nUp to 60% Off\nOver 100,000+ Sold\nUp to 60% Off\nOver 100,000+ Sold" },
    { "type": "textarea", "id": "marquee_sale_text", "label": "Sale marquee (one item per line)", "default": "Limited-Time Sale\nLow Stock\nLimited-Time Sale\nLow Stock\nLimited-Time Sale\nLow Stock" },
    { "type": "textarea", "id": "marquee_new_customer_text", "label": "New-customer marquee (one item per line)", "default": "New Customer Offer\nEnds Today\nNew Customer Offer\nEnds Today\nNew Customer Offer\nEnds Today" },

    { "type": "header", "content": "\"3 Features\" panel" },
    { "type": "text", "id": "features_heading_bold", "label": "Heading (emphasized part)", "default": "3 Features" },
    { "type": "text", "id": "features_heading_light", "label": "Heading (regular-weight part)", "default": "only women would think to include (seriously)" },

    { "type": "header", "content": "Press / as-seen-in" },
    { "type": "text", "id": "press_heading", "label": "Heading", "default": "Trusted By Top Rated Travel Companies Worldwide" },
    { "type": "text", "id": "press_label", "label": "Divider label", "default": "AS SEEN IN" },

    { "type": "header", "content": "Problem section" },
    { "type": "text", "id": "problem_heading", "label": "Heading", "default": "Still Struggling With Overstuffed, Awkward Bags? Let's Talk." },

    { "type": "header", "content": "Smart packing feature" },
    { "type": "image_picker", "id": "smart_packing_video_image", "label": "Video poster image" },
    { "type": "text", "id": "smart_packing_video_alt", "label": "Video poster alt text", "default": "Customer video testimonial" },
    { "type": "text", "id": "smart_packing_heading", "label": "Heading", "default": "A Whole New Meaning To Smart Packing—Space, Style, And Wrinkle-Free" },
    { "type": "textarea", "id": "smart_packing_copy", "label": "Body copy", "default": "Packing for a trip doesn't have to mean sacrificing your style or leaving essentials behind. The Lumatra Bag brings a whole new meaning to packing light, letting you carry everything you love without the bulk." },
    { "type": "text", "id": "icon_grid_1_title", "label": "Icon grid 1: title", "default": "Fits 10+ Days of Outfits" },
    { "type": "text", "id": "icon_grid_1_text", "label": "Icon grid 1: text", "default": "Space for every look you need." },
    { "type": "text", "id": "icon_grid_2_title", "label": "Icon grid 2: title", "default": "Multiple Pairs of Shoes" },
    { "type": "text", "id": "icon_grid_2_text", "label": "Icon grid 2: text", "default": "Pack heels, sneakers, and more." },
    { "type": "text", "id": "icon_grid_3_title", "label": "Icon grid 3: title", "default": "Toiletries & Essentials" },
    { "type": "text", "id": "icon_grid_3_text", "label": "Icon grid 3: text", "default": "Organized and easy to find." },
    { "type": "text", "id": "icon_grid_4_title", "label": "Icon grid 4: title", "default": "Wrinkle-Free Packing" },
    { "type": "text", "id": "icon_grid_4_text", "label": "Icon grid 4: text", "default": "Outfits stay fresh and ready." },

