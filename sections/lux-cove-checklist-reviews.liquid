{{ 'lux-cove.css' | asset_url | stylesheet_tag }}
<div class="{% if section.settings.pinkbg %}lc-pinkbg{% else %}lc-creambg{% endif %}"
     data-screen-label="Checklist and reviews"
     style="background-color: {% if section.settings.pinkbg %}#f6e3e5{% else %}#fffdfa{% endif %} !important; background: {% if section.settings.pinkbg %}#f6e3e5{% else %}#fffdfa{% endif %} !important;">
  <div class="lc-page" style="background:transparent !important">
    <div class="lc-sec" style="background:transparent !important">
      <div class="lc-sec-head">
        <span class="lc-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="lc-sec-t">{{ section.settings.heading }}</h2>
        <span class="lc-rule"></span>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="lc-col lc-gap12">
          {%- for block in section.blocks -%}
            <div class="lc-usprow" {{ block.shopify_attributes }}><span class="lc-usptick">✓</span>{{ block.settings.text }}</div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.review_count != blank -%}
        <div class="lc-revwidget">
          <span class="lc-ystars">★★★★★</span>
          <span class="lc-revcount">{{ section.settings.review_count }}</span>
          <span class="lc-fs13" style="color:#6a5f54"> {{ section.settings.review_text }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lux Cove: Checklist",
  "settings": [
    { "type": "checkbox", "id": "pinkbg", "label": "Pink background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why travelers switch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Easiest Travel Bag To Use For All Travelers" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "677+", "info": "Keep this consistent with the number used in the Reviews section further down the page." },
    { "type": "text", "id": "review_text", "label": "Review text", "default": "5 Star Reviews" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Checklist point",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Fits 10+ Days Of Clothes" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lux Cove: Checklist",
      "blocks": [
        { "type": "point", "settings": { "text": "Fits 10+ Days Of Clothes" } },
        { "type": "point", "settings": { "text": "Multi-Pocket Organization" } },
        { "type": "point", "settings": { "text": "Detachable Wheel Option Available" } },
        { "type": "point", "settings": { "text": "Carry-On Compliant For Most Major Airlines" } }
      ]
    }
  ]
}
{% endschema %}
