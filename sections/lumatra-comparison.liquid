{{ 'lumatra.css' | asset_url | stylesheet_tag }}
<div class="lm-page lm-comparebg">
  <div class="lm-sec">
    <h2 class="lm-sec-t lm-tc" style="margin-bottom:34px">{{ section.settings.heading | default: 'Not Just Better Superior In Every Way' }}</h2>
    <div class="lm-cmp-wrap">
      <div class="lm-cmp-grid">
        <div class="lm-cmp-label-head"><span class="lm-h3" style="font-size:15px">{{ section.settings.corner_label | default: 'US VS THEM' }}</span></div>
        <div class="lm-cmp-us-head"><span class="lm-h3" style="font-size:19px;color:#fff">{{ section.settings.brand_name | default: shop.name }}</span></div>
        <div class="lm-cmp-them-head"><span>{{ section.settings.them_label | default: 'Other Brands' }}</span></div>
        {%- for block in section.blocks -%}
          <div class="lm-cmp-row-label" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          <div class="lm-cmp-row-us"><span class="lm-cmp-check">✓</span></div>
          <div class="lm-cmp-row-them"><span class="lm-cmp-x">✕</span></div>
        {%- endfor -%}
        <div class="lm-cmp-foot-us"></div>
        <div class="lm-cmp-foot-them"></div>
      </div>
    </div>
    {%- if section.settings.cta_label != blank -%}
      <div class="lm-tc" style="margin-top:36px">
        <a href="{{ section.settings.cta_url | default: '#' }}" class="lm-btn lm-btn--lg">{{ section.settings.cta_label }}</a>
        <div class="lm-trust-row lm-jc">
          <span>✓ 100,000+ Sold</span>
          <span>✓ 100-Day Guarantee</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Lumatra: Comparison table",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not Just Better Superior In Every Way" },
    { "type": "text", "id": "corner_label", "label": "Table corner label", "default": "US VS THEM" },
    { "type": "text", "id": "brand_name", "label": "Your brand column label (blank = shop name)" },
    { "type": "text", "id": "them_label", "label": "\"Other brands\" column label", "default": "Other Brands" },
    { "type": "text", "id": "cta_label", "label": "CTA label (blank hides the button)", "default": "Configure Your Bag" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "blocks": [
    { "type": "row", "name": "Comparison row", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "One-Time Fee, Saves on Fees" }
    ]}
  ],
  "presets": [
    {
      "name": "Lumatra: Comparison table",
      "blocks": [
        { "type": "row", "settings": { "text": "One-Time Fee, Saves on Fees" } },
        { "type": "row", "settings": { "text": "Fits 38 Clothes & 5 Shoes" } },
        { "type": "row", "settings": { "text": "Carry-On Approved" } },
        { "type": "row", "settings": { "text": "Anti-Wrinkle Design" } },
        { "type": "row", "settings": { "text": "Built-in Hanger" } },
        { "type": "row", "settings": { "text": "Detachable Wheels & Handle" } },
        { "type": "row", "settings": { "text": "Durable & Waterproof" } },
        { "type": "row", "settings": { "text": "Organization Compartments" } }
      ]
    }
  ]
}
{% endschema %}
