<section class="lc-compare" data-section-id="{{ section.id }}">
  <div class="lc-wrap">
    <h2 class="lc-heading">{{ section.settings.heading }}</h2>

    <div class="lc-compare__table-wrap">
      <table class="lc-compare__table">
        <thead>
          <tr>
            <th></th>
            <th class="lc-compare__us">{{ section.settings.us_label }}</th>
            <th>{{ section.settings.them_label }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'row' %}
              <tr {{ block.shopify_attributes }}>
                <td class="lc-compare__feature">{{ block.settings.feature }}</td>
                <td class="lc-compare__us">{% if block.settings.us %}✓{% else %}—{% endif %}</td>
                <td>{% if block.settings.them %}✓{% else %}—{% endif %}</td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% stylesheet %}
  .lc-compare {
    padding: 64px 0;
  }

  .lc-compare__table-wrap {
    overflow-x: auto;
    border-radius: var(--lc-radius-lg);
    border: 1px solid var(--lc-line);
  }

  .lc-compare__table {
    width: 100%;
    border-collapse: collapse;
    min-width: 480px;
  }

  .lc-compare__table th,
  .lc-compare__table td {
    padding: 16px 20px;
    text-align: center;
    border-bottom: 1px solid var(--lc-line);
    font-size: 14px;
  }

  .lc-compare__table th {
    font-size: 13px;
    font-weight: 600;
    color: var(--lc-ink);
  }

  .lc-compare__feature {
    text-align: left;
    color: var(--lc-muted);
  }

  .lc-compare__us {
    background: var(--lc-pink-soft);
    color: var(--lc-pink-deep);
    font-weight: 700;
  }

  .lc-compare__table tr:last-child td {
    border-bottom: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Us vs Other Brands"
    },
    {
      "type": "text",
      "id": "us_label",
      "label": "Us column label",
      "default": "Our Glasses"
    },
    {
      "type": "text",
      "id": "them_label",
      "label": "Competitor column label",
      "default": "Other Brands"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Red light + EMS therapy" },
        { "type": "checkbox", "id": "us", "label": "We have it", "default": true },
        { "type": "checkbox", "id": "them", "label": "They have it", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        { "type": "row", "settings": { "feature": "Red light + EMS therapy", "us": true, "them": false } },
        { "type": "row", "settings": { "feature": "Rechargeable & cordless", "us": true, "them": false } },
        { "type": "row", "settings": { "feature": "Use at home in minutes", "us": true, "them": false } },
        { "type": "row", "settings": { "feature": "30-day money-back guarantee", "us": true, "them": false } },
        { "type": "row", "settings": { "feature": "One-time cost", "us": true, "them": false } }
      ]
    }
  ]
}
{% endschema %}
