<div class="steps page-width color-scheme-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="steps__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <ol class="steps__list">
    {%- for block in section.blocks -%}
      <li class="steps__item" {{ block.shopify_attributes }}>
        <span class="steps__number">{{ forloop.index }}</span>
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 600 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {%- endif -%}
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </li>
    {%- endfor -%}
  </ol>
</div>

{% schema %}
{
  "name": "Steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" }
      ],
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A short description of this step." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "step", "settings": { "title": "Cleanse", "text": "Start with a clean, dry face." } },
      { "type": "step", "settings": { "title": "Apply", "text": "Use nightly for best results." } },
      { "type": "step", "settings": { "title": "Glow", "text": "See results within a few weeks." } }
    ]
  },
  "presets": [{ "name": "Steps" }]
}
{% endschema %}
