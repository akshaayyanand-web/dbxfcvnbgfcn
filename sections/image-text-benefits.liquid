<div class="benefit-panels">
  {%- for block in section.blocks -%}
    <div class="benefit-panel benefit-panel--{{ block.settings.image_position }} color-scheme-{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}>
      <div class="benefit-panel__media">
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 900 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {%- endif -%}
      </div>
      <div class="benefit-panel__content page-width">
        <div class="benefit-panel__text">
          {%- if block.settings.result != blank -%}
            <span class="eyebrow">{{ block.settings.result }}</span>
          {%- endif -%}
          <h2>{{ block.settings.heading }}</h2>
          <div class="rte">{{ block.settings.text }}</div>
        </div>
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Benefit panels",
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
        { "type": "text", "id": "result", "label": "Result label", "default": "Result" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Benefit heading" },
        { "type": "richtext", "id": "text", "label": "Text" },
        {
          "type": "select",
          "id": "color_scheme",
          "label": "Color scheme",
          "options": [
            { "value": "scheme-1", "label": "Scheme 1" },
            { "value": "scheme-2", "label": "Scheme 2" },
            { "value": "scheme-3", "label": "Scheme 3" }
          ],
          "default": "scheme-1"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "panel", "settings": { "image_position": "left", "result": "Result", "heading": "Softer look around the eyes" } },
      { "type": "panel", "settings": { "image_position": "right", "result": "Result", "heading": "A brighter, more rested look" } }
    ]
  },
  "presets": [{ "name": "Benefit panels" }]
}
{% endschema %}
