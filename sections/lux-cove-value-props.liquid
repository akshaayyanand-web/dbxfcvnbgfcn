{{ 'lux-cove.css' | asset_url | stylesheet_tag }}
<div class="{% if section.settings.pinkbg %}lc-pinkbg{% endif %}" data-screen-label="Value props">
  <div class="lc-page">
    <section style="padding:{{ section.settings.padding_y }}px 22px">
      {%- if section.settings.heading != blank -%}
        <div class="lc-sec-head"><h2 class="lc-sec-t">{{ section.settings.heading }}</h2></div>
      {%- endif -%}
      <div class="lc-vpgrid">
        {%- for block in section.blocks -%}
          <div class="lc-vpcol" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="lc-vpicon">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="10" r="7"></circle><path d="M9 10l2 2 4-4"></path><path d="M8 16l-1 5 5-2 5 2-1-5"></path></svg>
                  {%- when 'truck' -%}<svg viewBox="0 0 24 24"><rect x="2" y="7" width="13" height="10" rx="1"></rect><path d="M15 10h4l3 3v4h-7z"></path><circle cx="7" cy="19" r="1.6"></circle><circle cx="18" cy="19" r="1.6"></circle></svg>
                  {%- when 'lock' -%}<svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
                  {%- when 'sparkle' -%}<svg viewBox="0 0 24 24"><path d="M12 3l2 6 6 2-6 2-2 6-2-6-6-2 6-2z"></path></svg>
                  {%- when 'clock' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                  {%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M8 12l3 3 5-6"></path></svg>
                {%- endcase -%}
              </span>
            {%- endif -%}
            <div class="lc-vptitle">{{ block.settings.title }}</div>
            {%- if block.settings.text != blank -%}
              <div class="lc-vptext">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </section>
  </div>
</div>

{% stylesheet %}
  .lc-vpgrid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px 14px; }
  .lc-vpcol { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 9px; }
  .lc-vpicon svg { width: 30px; height: 30px; stroke: var(--lc-gold); fill: none; stroke-width: 1.3; }
  .lc-vptitle { font-size: 12.5px; font-weight: 600; line-height: 1.3; color: #2a2320; }
  .lc-vptext { font-size: 11px; color: #6a5f54; line-height: 1.5; max-width: 200px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Lux Cove: Value props",
  "settings": [
    { "type": "checkbox", "id": "pinkbg", "label": "Pink background", "default": false },
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 20, "max": 80, "step": 2, "default": 40 }
  ],
  "blocks": [
    {
      "type": "prop",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "check", "label": "Check" },
          { "value": "shield", "label": "Shield" },
          { "value": "truck", "label": "Shipping" },
          { "value": "lock", "label": "Lock / secure" },
          { "value": "sparkle", "label": "Sparkle" },
          { "value": "clock", "label": "Clock" },
          { "value": "none", "label": "No icon" }
        ], "default": "check" },
        { "type": "text", "id": "title", "label": "Title", "default": "Professional-Level Treatment" },
        { "type": "textarea", "id": "text", "label": "Description (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lux Cove: Value props",
      "blocks": [
        { "type": "prop", "settings": { "icon": "sparkle", "title": "Professional-Level Treatment", "text": "Enjoy professional-grade skincare in the comfort of your own home." } },
        { "type": "prop", "settings": { "icon": "check", "title": "Long-Term Results", "text": "Promotes collagen production, reduces inflammation and encourages cellular renewal." } },
        { "type": "prop", "settings": { "icon": "clock", "title": "Save Energy & Time", "text": "Maximum results in minimal time — healthy skin without hours on your routine." } }
      ]
    }
  ]
}
{% endschema %}
