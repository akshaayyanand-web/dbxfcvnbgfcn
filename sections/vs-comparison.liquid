<section class="lc-vs" data-section-id="{{ section.id }}">
  <div class="lc-wrap">
    <h2 class="lc-heading">{{ section.settings.heading }}</h2>

    <div class="lc-vs__grid">
      <div class="lc-vs__col lc-vs__col--us">
        <div class="lc-vs__media">
          {% if section.settings.us_image != blank %}
            <img src="{{ section.settings.us_image | image_url: width: 600 }}" alt="{{ section.settings.us_label | escape }}" loading="lazy">
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <h3>{{ section.settings.us_label }}</h3>
        <ul>
          <li><span aria-hidden="true">✓</span>{{ section.settings.us_point_1 }}</li>
          <li><span aria-hidden="true">✓</span>{{ section.settings.us_point_2 }}</li>
          <li><span aria-hidden="true">✓</span>{{ section.settings.us_point_3 }}</li>
        </ul>
      </div>

      <div class="lc-vs__col lc-vs__col--them">
        <div class="lc-vs__media">
          {% if section.settings.them_image != blank %}
            <img src="{{ section.settings.them_image | image_url: width: 600 }}" alt="{{ section.settings.them_label | escape }}" loading="lazy">
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <h3>{{ section.settings.them_label }}</h3>
        <ul>
          <li><span aria-hidden="true">✕</span>{{ section.settings.them_point_1 }}</li>
          <li><span aria-hidden="true">✕</span>{{ section.settings.them_point_2 }}</li>
          <li><span aria-hidden="true">✕</span>{{ section.settings.them_point_3 }}</li>
        </ul>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .lc-vs {
    padding: 56px 0;
  }

  .lc-vs__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .lc-vs__col {
    border-radius: var(--lc-radius-lg);
    padding: 28px;
  }

  .lc-vs__col--us {
    background: var(--lc-pink-soft);
  }

  .lc-vs__col--them {
    background: #f4f2f0;
  }

  .lc-vs__media {
    border-radius: var(--lc-radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin-bottom: 18px;
  }

  .lc-vs__media img,
  .lc-vs__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lc-vs__col h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--lc-ink);
    margin: 0 0 14px;
  }

  .lc-vs__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .lc-vs__col li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    color: var(--lc-ink);
    line-height: 1.5;
  }

  .lc-vs__col--us li span {
    color: var(--lc-pink-deep);
    font-weight: 700;
  }

  .lc-vs__col--them li span {
    color: #a39a94;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .lc-vs__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vs Comparison",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Us vs the alternative" },
    { "type": "image_picker", "id": "us_image", "label": "Our image" },
    { "type": "text", "id": "us_label", "label": "Our label", "default": "Our Under-Eye Glasses" },
    { "type": "text", "id": "us_point_1", "label": "Our point 1" },
    { "type": "text", "id": "us_point_2", "label": "Our point 2" },
    { "type": "text", "id": "us_point_3", "label": "Our point 3" },
    { "type": "image_picker", "id": "them_image", "label": "Their image" },
    { "type": "text", "id": "them_label", "label": "Their label", "default": "The Alternative" },
    { "type": "text", "id": "them_point_1", "label": "Their point 1" },
    { "type": "text", "id": "them_point_2", "label": "Their point 2" },
    { "type": "text", "id": "them_point_3", "label": "Their point 3" }
  ],
  "presets": [
    { "name": "Vs Comparison" }
  ]
}
{% endschema %}
