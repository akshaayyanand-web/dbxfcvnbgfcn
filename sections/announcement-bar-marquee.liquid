{%- liquid
  assign items = section.blocks
  assign speed = section.settings.speed
-%}

{%- if items.size > 0 -%}
  <div
    class="announcement-bar__link"
    style="--announcement-bg: {{ section.settings.bg_color }}; --announcement-text: {{ section.settings.text_color }}; --announcement-dot: {{ section.settings.dot_color }};"
  >
    <div class="marq" id="marq-{{ section.id }}">
      <span id="orig">
        <ul class="ss-announcement-bar__message" style="--marq-speed: {{ speed }}s">
          {%- for pass in (1..2) -%}
            {%- for block in items -%}
              <li {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
                {%- else -%}
                  {{ block.settings.text }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      </span>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement-bar__link {
    background: var(--announcement-bg, #2a2320);
    overflow: hidden;
    padding: 11px 0;
  }
  .marq {
    overflow: hidden;
    width: 100%;
  }
  .ss-announcement-bar__message {
    display: flex;
    flex: none;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: announcement-marquee var(--marq-speed, 32s) linear infinite;
  }
  .ss-announcement-bar__message:hover {
    animation-play-state: paused;
  }
  .ss-announcement-bar__message li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 26px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    white-space: nowrap;
    color: var(--announcement-text, #f0e6d8);
    text-transform: uppercase;
  }
  .ss-announcement-bar__message li:not(:last-child)::after {
    content: '';
    width: 4px;
    height: 4px;
    margin-left: 26px;
    background: var(--announcement-dot, #b08d57);
    border-radius: 50%;
    flex: none;
  }
  .ss-announcement-bar__message a {
    color: inherit;
    text-decoration: none;
  }
  @keyframes announcement-marquee {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ss-announcement-bar__message {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#2a2320" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#f0e6d8" },
    { "type": "color", "id": "dot_color", "label": "Dot color", "default": "#b08d57" },
    { "type": "range", "id": "speed", "label": "Scroll speed (seconds)", "min": 10, "max": 80, "step": 1, "default": 32 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Summer Sale" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement marquee",
      "blocks": [
        { "type": "message", "settings": { "text": "Summer Sale" } },
        { "type": "message", "settings": { "text": "Up To 40% Off Sitewide" } },
        { "type": "message", "settings": { "text": "Free Shipping" } },
        { "type": "message", "settings": { "text": "150,000+ Happy Customers" } }
      ]
    }
  ]
}
{% endschema %}
