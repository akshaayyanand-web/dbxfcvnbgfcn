<div class="testimonials page-width color-scheme-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="testimonials__track">
    {%- for block in section.blocks -%}
      <blockquote class="testimonials__item" {{ block.shopify_attributes }}>
        <div class="testimonials__rating" aria-hidden="true">
          {%- for i in (1..5) -%}
            <span class="{% if i <= block.settings.rating %}is-filled{% endif %}">&#9733;</span>
          {%- endfor -%}
        </div>
        <p class="testimonials__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
        <cite class="testimonials__author">{{ block.settings.author }}</cite>
      </blockquote>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by thousands" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" }
      ],
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "This changed my routine completely." },
        { "type": "text", "id": "author", "label": "Author", "default": "Happy customer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "testimonial", "settings": { "quote": "This changed my routine completely.", "author": "Happy customer" } },
      { "type": "testimonial", "settings": { "quote": "Results after two weeks, no joke.", "author": "Verified buyer" } }
    ]
  },
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
