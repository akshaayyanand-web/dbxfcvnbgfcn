{{ 'lux-cove.css' | asset_url | stylesheet_tag }}
{%- if section.settings.enabled -%}
<div class="lc-page" style="max-width:none;box-shadow:none;margin:0">
  <div class="lc-annbar" style="--lc-mspeed:{{ section.settings.speed }}s">
    <div class="lc-anntrack">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <div class="lc-annitem" {{ block.shopify_attributes }}>
            <span>{{ block.settings.text }}</span>
            <span class="lc-dot"></span>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Lux Cove: Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show announcement bar", "default": true },
    { "type": "range", "id": "speed", "label": "Scroll speed (seconds)", "min": 10, "max": 80, "step": 1, "default": 32 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Summer Sale" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lux Cove: Announcement bar",
      "blocks": [
        { "type": "item", "settings": { "text": "Summer Sale" } },
        { "type": "item", "settings": { "text": "40% Off Sitewide" } },
        { "type": "item", "settings": { "text": "Free Shipping" } },
        { "type": "item", "settings": { "text": "150,000+ Happy Customers" } }
      ]
    }
  ]
}
{% endschema %}
