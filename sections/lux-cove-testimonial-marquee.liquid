<style>
  /* Isolates the pink background strictly to this specific section wrapper and its main internal blocks */
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} .lc-page,
  #shopify-section-{{ section.id }} section[data-screen-label="Testimonials marquee"] {
    background: #f6e3e5 !important;
    background-color: #f6e3e5 !important;
  }
</style>

{{ 'lux-cove.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign row1 = section.blocks | where: 'type', 'testimonial_row1'
  assign row2 = section.blocks | where: 'type', 'testimonial_row2'
-%}
<div class="lc-page">
  <section style="padding:48px 0" data-screen-label="Testimonials marquee">
    <div class="lc-sec-head" style="padding:0 22px">
      <span class="lc-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="lc-sec-t">{{ section.settings.heading }}</h2>
      <span class="lc-rule"></span>
    </div>

    {%- if row1.size > 0 -%}
      <div style="overflow:hidden">
        <div class="lc-anntrack" style="animation-duration:70s">
          {%- for i in (1..2) -%}
            {%- for block in row1 -%}
              <div class="lc-pill" {{ block.shopify_attributes }}>
                <div class="lc-fx lc-ac lc-gap10">
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 88 }}" width="44" height="44" loading="lazy" class="lc-pillav" alt="{{ block.settings.name | escape }}">
                  {%- elsif block.settings.external_image_url != blank -%}
                    <img src="{{ block.settings.external_image_url }}" width="44" height="44" loading="lazy" class="lc-pillav" alt="{{ block.settings.name | escape }}">
                  {%- elsif block.settings.fallback_image != 'none' -%}
                    <img src="{{ block.settings.fallback_image | append: '.jpg' | asset_url }}" width="44" height="44" loading="lazy" class="lc-pillav" alt="{{ block.settings.name | escape }}">
                  {%- endif -%}
                  <div><div class="lc-fw6 lc-fs13">{{ block.settings.name }}</div><div class="lc-stars lc-fs12">★★★★★</div></div>
                </div>
                <div style="font-style:italic">"{{ block.settings.quote }}"</div>
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if row2.size > 0 -%}
      <div style="overflow:hidden;margin-top:14px">
        <div class="lc-anntrack" style="animation-duration:70s;animation-direction:reverse">
          {%- for i in (1..2) -%}
            {%- for block in row2 -%}
              <div class="lc-pill" {{ block.shopify_attributes }}>
                <div class="lc-fx lc-ac lc-gap10">
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 88 }}" width="44" height="44" loading="lazy" class="lc-pillav" alt="{{ block.settings.name | escape }}">
                  {%- elsif block.settings.external_image_url != blank -%}
                    <img src="{{ block.settings.external_image_url }}" width="44" height="44" loading="lazy" class="lc-pillav" alt="{{ block.settings.name | escape }}">
                  {%- elsif block.settings.fallback_image != 'none' -%}
                    <img src="{{ block.settings.fallback_image | append: '.jpg' | asset_url }}" width="44" height="44" loading="lazy" class="lc-pillav" alt="{{ block.settings.name | escape }}">
                  {%- endif -%}
                  <div><div class="lc-fw6 lc-fs13">{{ block.settings.name }}</div><div class="lc-stars lc-fs12">★★★★★</div></div>
                </div>
                <div style="font-style:italic">"{{ block.settings.quote }}"</div>
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Lux Cove: Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved worldwide" },
