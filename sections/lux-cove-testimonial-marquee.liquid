        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "url", "id": "external_image_url", "label": "External photo URL (used until you pick one above)" },
        { "type": "select", "id": "fallback_image", "label": "Placeholder photo (used until neither of the above is set)", "options": [
          { "value": "none", "label": "None" },
          { "value": "lc-av1", "label": "Avatar 1" },
          { "value": "lc-av2", "label": "Avatar 2" },
          { "value": "lc-av3", "label": "Avatar 3" },
          { "value": "lc-av4", "label": "Avatar 4" },
