{{ 'lumatra.css' | asset_url | stylesheet_tag }}
<div class="lm-page lm-creambg">
  <div class="lm-sec" style="padding-bottom:24px">
    <div class="lm-sec-head">
      <h2 class="lm-sec-t">{{ section.settings.heading | default: 'Rated As The #1 Travel Bag Of 2025' }}</h2>
      {%- if section.settings.subheading != blank -%}
        <div class="lm-fs14" style="color:var(--lm-muted-1)">{{ section.settings.subheading }}</div>
      {%- endif -%}
      <div class="lm-fx lm-ac lm-gap8">
        <span class="lm-stars">★★★★★</span>
        <span class="lm-fs13">{{ section.settings.rating_text | default: 'Rated 4.8/5 based on 1346+' }}</span>
      </div>
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <div class="lm-loop" style="padding:0 0 56px">
      <div class="lm-looptrack" style="--lm-loop-duration:{{ section.settings.speed | default: 34 }}s;">
        {%- for n in (1..2) -%}
          {%- for block in section.blocks -%}
            <div class="lm-loopcard" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 380 }}" width="190" height="280" loading="lazy" alt="Customer with {{ shop.name }} bag">
              {%- elsif block.settings.fallback_image != 'none' -%}
                <img src="{{ block.settings.fallback_image | append: '.png' | asset_url }}" width="190" height="280" loading="lazy" style="object-fit:cover" alt="Customer with {{ shop.name }} bag">
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Lumatra: Lifestyle marquee",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rated As The #1 Travel Bag Of 2025" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "And it's pretty easy to see why..." },
    { "type": "text", "id": "rating_text", "label": "Rating line", "default": "Rated 4.8/5 based on 1346+" },
    { "type": "range", "id": "speed", "label": "Scroll speed (lower = faster)", "min": 10, "max": 80, "step": 1, "default": 34, "unit": "s" }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "select", "id": "fallback_image", "label": "Placeholder (used until an image is picked)", "options": [
        { "value": "none", "label": "None" },
        { "value": "lumatra-life-1", "label": "Lifestyle 1" },
        { "value": "lumatra-life-2", "label": "Lifestyle 2" },
        { "value": "lumatra-life-3", "label": "Lifestyle 3" },
        { "value": "lumatra-life-4", "label": "Lifestyle 4" },
        { "value": "lumatra-life-5", "label": "Lifestyle 5" }
      ], "default": "none" }
    ]}
  ],
  "presets": [
    {
      "name": "Lumatra: Lifestyle marquee",
      "blocks": [
        { "type": "photo", "settings": { "fallback_image": "lumatra-life-1" } },
        { "type": "photo", "settings": { "fallback_image": "lumatra-life-2" } },
        { "type": "photo", "settings": { "fallback_image": "lumatra-life-3" } },
        { "type": "photo", "settings": { "fallback_image": "lumatra-life-4" } },
        { "type": "photo", "settings": { "fallback_image": "lumatra-life-5" } }
      ]
    }
  ]
}
{% endschema %}
