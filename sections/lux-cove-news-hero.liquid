{{ 'lux-cove.css' | asset_url | stylesheet_tag }}
<div class="lc-newsbg" data-screen-label="News hero">
  <div class="lc-page" style="background:transparent !important">
    <div class="lc-sec lc-tc" style="background:transparent !important;padding-bottom:44px">
      <span class="lc-newsbadge">{{ section.settings.badge }}</span>
      <h1 class="lc-newshead">{{ section.settings.heading }}</h1>
      <p class="lc-newstxt">{{ section.settings.text }}</p>

      {%- if section.settings.image != blank or section.settings.external_image_url != blank -%}
        <div class="lc-vidcard" style="width:220px;margin:26px auto 0;aspect-ratio:9/14">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 440 }}" width="220" height="{{ 220 | divided_by: section.settings.image.aspect_ratio | round }}" loading="lazy" alt="{{ section.settings.heading | escape_once }}">
          {%- else -%}
            <img src="{{ section.settings.external_image_url }}" width="220" height="340" loading="lazy" style="object-fit:cover" alt="{{ section.settings.heading | escape_once }}">
          {%- endif -%}
          {%- if section.settings.show_play_icon -%}
            <span class="lc-play">▶</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="lc-newscta">
          <a href="{{ section.settings.button_link | default: '#shopify-section-main' }}" class="button">{{ section.settings.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lux Cove: News hero",
  "settings": [
    { "type": "text", "id": "badge", "label": "Eyebrow badge", "default": "Travel News" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Airlines Collect Billions In Bag Fees Every Year — Most Of It Avoidable" },
    { "type": "textarea", "id": "text", "label": "Body text", "default": "Most airlines let you bring one personal-size item on board free, in addition to your carry-on. Lumatra is built to the exact edge of that allowance, so you use every inch you're already owed." },
    { "type": "image_picker", "id": "image", "label": "Image or video thumbnail" },
    { "type": "url", "id": "external_image_url", "label": "External image URL (used until you pick one above)" },
    { "type": "checkbox", "id": "show_play_icon", "label": "Show video play icon", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Lumatra Travel Bag" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Lux Cove: News hero" }
  ]
}
{% endschema %}
