<section class="lc-testimonials" data-section-id="{{ section.id }}">
  <div class="lc-wrap">
    <h2 class="lc-heading">{{ section.settings.heading }}</h2>

    <div class="lc-testimonials__track" data-lc-track>
      {% for block in section.blocks %}
        {% if block.type == 'testimonial' %}
          <div class="lc-testimonials__card" {{ block.shopify_attributes }}>
            <div class="lc-testimonials__photo">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <span class="lc-testimonials__stars" aria-hidden="true">★★★★★</span>
            <p class="lc-testimonials__quote">{{ block.settings.quote }}</p>
            <span class="lc-testimonials__name">{{ block.settings.name }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="lc-testimonials__dots" data-lc-dots></div>
  </div>
</section>

{% stylesheet %}
  .lc-testimonials {
    padding: 64px 0;
    background: var(--lc-pink-soft);
    border-radius: var(--lc-radius-lg);
  }

  .lc-testimonials__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 8px;
    scrollbar-width: none;
  }

  .lc-testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .lc-testimonials__card {
    flex: 0 0 300px;
    scroll-snap-align: start;
    background: var(--lc-white);
    border-radius: var(--lc-radius-md);
    padding: 24px;
    box-shadow: var(--lc-shadow);
    text-align: center;
  }

  .lc-testimonials__photo {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    margin: 0 auto 14px;
    background: var(--lc-pink-soft);
  }

  .lc-testimonials__photo img,
  .lc-testimonials__photo svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lc-testimonials__stars {
    color: var(--lc-pink-deep);
    display: block;
    margin-bottom: 10px;
    letter-spacing: 2px;
  }

  .lc-testimonials__quote {
    font-size: 14px;
    color: var(--lc-ink);
    line-height: 1.6;
    margin: 0 0 12px;
  }

  .lc-testimonials__name {
    font-size: 13px;
    font-weight: 600;
    color: var(--lc-muted);
  }

  .lc-testimonials__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .lc-testimonials__dots button {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: var(--lc-line);
    cursor: pointer;
    padding: 0;
  }

  .lc-testimonials__dots button.is-active {
    background: var(--lc-pink-deep);
  }
{% endstylesheet %}

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var root = document.querySelector('.lc-testimonials[data-section-id="' + sectionId + '"]');
    if (!root || root.dataset.lcInit) return;
    root.dataset.lcInit = 'true';

    var track = root.querySelector('[data-lc-track]');
    var dotsWrap = root.querySelector('[data-lc-dots]');
    var cards = track.querySelectorAll('.lc-testimonials__card');
    if (!cards.length) return;

    cards.forEach(function (_, index) {
      var dot = document.createElement('button');
      dot.type = 'button';
      if (index === 0) dot.classList.add('is-active');
      dot.addEventListener('click', function () {
        cards[index].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
      });
      dotsWrap.appendChild(dot);
    });

    var dots = dotsWrap.querySelectorAll('button');
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var index = Array.prototype.indexOf.call(cards, entry.target);
        if (entry.isIntersecting && index > -1) {
          dots.forEach(function (d) { d.classList.remove('is-active'); });
          dots[index].classList.add('is-active');
        }
      });
    }, { root: track, threshold: 0.6 });

    cards.forEach(function (card) { observer.observe(card); });
  })();
</script>

{% schema %}
{
  "name": "Testimonial Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Customers, Real Results"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "This has become part of my morning routine. My under-eyes look so much brighter after just a few weeks." },
        { "type": "text", "id": "name", "label": "Name", "default": "Hannah K." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial Carousel",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "Hannah K." } },
        { "type": "testimonial", "settings": { "name": "Elena R." } },
        { "type": "testimonial", "settings": { "name": "Alicia M." } }
      ]
    }
  ]
}
{% endschema %}
