{% render 'lc-styles' %}

{% liquid
  assign product = product
  assign current_variant = product.selected_or_first_available_variant
%}

<section class="lc-main-product" data-section-id="{{ section.id }}">
  <div class="lc-wrap lc-main-product__grid">

    <div class="lc-main-product__gallery">
      <div class="lc-main-product__main-media">
        {% if current_variant.featured_media %}
          <img
            id="lc-main-image-{{ section.id }}"
            src="{{ current_variant.featured_media | image_url: width: 900 }}"
            alt="{{ current_variant.featured_media.alt | default: product.title | escape }}"
            width="900"
            height="900"
            loading="eager"
          >
        {% elsif product.featured_media %}
          <img
            id="lc-main-image-{{ section.id }}"
            src="{{ product.featured_media | image_url: width: 900 }}"
            alt="{{ product.featured_media.alt | default: product.title | escape }}"
            width="900"
            height="900"
            loading="eager"
          >
        {% else %}
          <div class="lc-main-product__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <div class="lc-main-product__thumbs">
          {% for media in product.media limit: 6 %}
            <button
              type="button"
              class="lc-main-product__thumb{% if forloop.first %} is-active{% endif %}"
              data-lc-thumb
              data-full-src="{{ media | image_url: width: 900 }}"
            >
              <img src="{{ media | image_url: width: 150 }}" alt="{{ media.alt | escape }}" width="72" height="72" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="lc-main-product__info">
      {% if section.settings.show_rating %}
        <div class="lc-main-product__rating">
          <span class="lc-main-product__stars" aria-hidden="true">★★★★★</span>
          <span class="lc-main-product__rating-text">{{ section.settings.rating_text }}</span>
        </div>
      {% endif %}

      <h1 class="lc-main-product__title">{{ product.title }}</h1>

      <div class="lc-main-product__price">
        <span class="lc-main-product__price-current">{{ current_variant.price | money }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="lc-main-product__price-compare">{{ current_variant.compare_at_price | money }}</span>
          <span class="lc-pill">Save {{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}%</span>
        {% endif %}
      </div>

      {% if section.settings.subheading != blank %}
        <p class="lc-main-product__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% form 'product', product, id: 'lc-product-form', class: 'lc-main-product__form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="lc-variant-id-{{ section.id }}">

        {% for option in product.options_with_values %}
          <div class="lc-main-product__option">
            <span class="lc-main-product__option-label">{{ option.name }}</span>
            <div class="lc-main-product__option-values">
              {% for value in option.values %}
                <label class="lc-main-product__swatch">
                  <input
                    type="radio"
                    name="lc-option-{{ option.position }}"
                    value="{{ value | escape }}"
                    {% if option.selected_value == value %}checked{% endif %}
                    data-lc-option-index="{{ option.position | minus: 1 }}"
                  >
                  <span>{{ value }}</span>
                </label>
              {% endfor %}
            </div>
          </div>
        {% endfor %}

        <div class="lc-main-product__quantity">
          <span class="lc-main-product__option-label">Quantity</span>
          <div class="lc-main-product__qty-control">
            <button type="button" data-lc-qty-decrease aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" value="1" min="1" data-lc-qty-input>
            <button type="button" data-lc-qty-increase aria-label="Increase quantity">+</button>
          </div>
        </div>

        <button
          type="submit"
          class="lc-btn lc-main-product__add-to-cart"
          {% unless current_variant.available %}disabled{% endunless %}
          data-lc-add-to-cart
        >
          <span data-lc-atc-text>
            {% if current_variant.available %}{{ section.settings.cta_text }}{% else %}Sold Out{% endif %}
          </span>
        </button>
      {% endform %}

      {% if section.settings.show_trust_row %}
        <ul class="lc-main-product__trust-row">
          <li>{{ section.settings.trust_1 }}</li>
          <li>{{ section.settings.trust_2 }}</li>
          <li>{{ section.settings.trust_3 }}</li>
        </ul>
      {% endif %}

      {% if section.settings.benefits != blank %}
        <div class="lc-main-product__benefits">{{ section.settings.benefits }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .lc-main-product {
    padding: 40px 0 64px;
  }

  .lc-main-product__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: flex-start;
  }

  .lc-main-product__main-media {
    border-radius: var(--lc-radius-lg);
    overflow: hidden;
    background: var(--lc-pink-soft);
    aspect-ratio: 1 / 1;
  }

  .lc-main-product__main-media img,
  .lc-main-product__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lc-main-product__thumbs {
    display: flex;
    gap: 10px;
    margin-top: 14px;
  }

  .lc-main-product__thumb {
    border: 2px solid transparent;
    border-radius: var(--lc-radius-sm);
    overflow: hidden;
    padding: 0;
    background: none;
    cursor: pointer;
    width: 72px;
    height: 72px;
  }

  .lc-main-product__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lc-main-product__thumb.is-active {
    border-color: var(--lc-pink-deep);
  }

  .lc-main-product__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .lc-main-product__stars {
    color: var(--lc-pink-deep);
    letter-spacing: 2px;
  }

  .lc-main-product__rating-text {
    font-size: 13px;
    color: var(--lc-muted);
  }

  .lc-main-product__title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    color: var(--lc-ink);
    margin: 0 0 12px;
    line-height: 1.25;
  }

  .lc-main-product__price {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .lc-main-product__price-current {
    font-size: 22px;
    font-weight: 700;
    color: var(--lc-ink);
  }

  .lc-main-product__price-compare {
    font-size: 16px;
    color: var(--lc-muted);
    text-decoration: line-through;
  }

  .lc-main-product__subheading {
    color: var(--lc-muted);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .lc-main-product__option {
    margin-bottom: 20px;
  }

  .lc-main-product__option-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--lc-ink);
    margin-bottom: 8px;
  }

  .lc-main-product__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .lc-main-product__swatch {
    position: relative;
  }

  .lc-main-product__swatch input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }

  .lc-main-product__swatch span {
    display: inline-flex;
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid var(--lc-line);
    font-size: 14px;
    color: var(--lc-ink);
  }

  .lc-main-product__swatch input:checked + span {
    border-color: var(--lc-ink);
    background: var(--lc-ink);
    color: var(--lc-white);
  }

  .lc-main-product__quantity {
    margin-bottom: 24px;
  }

  .lc-main-product__qty-control {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--lc-line);
    border-radius: 999px;
    overflow: hidden;
  }

  .lc-main-product__qty-control button {
    background: none;
    border: none;
    width: 40px;
    height: 40px;
    font-size: 18px;
    cursor: pointer;
  }

  .lc-main-product__qty-control input {
    width: 42px;
    text-align: center;
    border: none;
    font-size: 15px;
    -moz-appearance: textfield;
  }

  .lc-main-product__add-to-cart {
    width: 100%;
    padding: 18px 32px;
    font-size: 16px;
  }

  .lc-main-product__add-to-cart[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .lc-main-product__trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    list-style: none;
    padding: 20px 0 0;
    margin: 20px 0 0;
    border-top: 1px solid var(--lc-line);
    font-size: 13px;
    color: var(--lc-muted);
  }

  .lc-main-product__benefits {
    margin-top: 20px;
    color: var(--lc-muted);
    line-height: 1.7;
  }

  @media screen and (max-width: 900px) {
    .lc-main-product__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var root = document.querySelector('[data-section-id="' + sectionId + '"]');
    if (!root || root.dataset.lcInit) return;
    root.dataset.lcInit = 'true';

    var mainImage = document.getElementById('lc-main-image-' + sectionId);
    root.querySelectorAll('[data-lc-thumb]').forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        root.querySelectorAll('[data-lc-thumb]').forEach(function (t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');
        if (mainImage) mainImage.src = thumb.getAttribute('data-full-src');
      });
    });

    var qtyInput = root.querySelector('[data-lc-qty-input]');
    var decrease = root.querySelector('[data-lc-qty-decrease]');
    var increase = root.querySelector('[data-lc-qty-increase]');
    if (qtyInput && decrease && increase) {
      decrease.addEventListener('click', function () {
        qtyInput.value = Math.max(1, (parseInt(qtyInput.value, 10) || 1) - 1);
      });
      increase.addEventListener('click', function () {
        qtyInput.value = (parseInt(qtyInput.value, 10) || 1) + 1;
      });
    }

    var variants = {{ product.variants | json }};
    var optionInputs = root.querySelectorAll('[data-lc-option-index]');
    var variantIdInput = document.getElementById('lc-variant-id-' + sectionId);
    var addToCartBtn = root.querySelector('[data-lc-add-to-cart]');
    var atcText = root.querySelector('[data-lc-atc-text]');
    var priceCurrent = root.querySelector('.lc-main-product__price-current');

    function selectedOptions() {
      var groups = {};
      optionInputs.forEach(function (input) {
        if (input.checked) groups[input.dataset.lcOptionIndex] = input.value;
      });
      return groups;
    }

    function findMatchingVariant() {
      var selected = selectedOptions();
      return variants.find(function (variant) {
        return Object.keys(selected).every(function (index) {
          return variant.options[parseInt(index, 10)] === selected[index];
        });
      });
    }

    function updateForVariant(variant) {
      if (!variant) return;
      if (variantIdInput) variantIdInput.value = variant.id;
      if (priceCurrent) priceCurrent.textContent = (variant.price / 100).toLocaleString(undefined, { style: 'currency', currency: {{ cart.currency.iso_code | json }} });
      if (addToCartBtn) {
        addToCartBtn.disabled = !variant.available;
        if (atcText) atcText.textContent = variant.available ? {{ section.settings.cta_text | json }} : 'Sold Out';
      }
      if (mainImage && variant.featured_media) {
        mainImage.src = variant.featured_media.preview_image.src + '&width=900';
      }
    }

    optionInputs.forEach(function (input) {
      input.addEventListener('change', function () {
        updateForVariant(findMatchingVariant());
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Product Showcase",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating row",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "4.9 out of 5 — 12,000+ reviews"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Red light + EMS therapy for smoother, brighter, more youthful-looking eyes — in just 10 minutes a day."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Add to cart button text",
      "default": "Add To Cart"
    },
    {
      "type": "checkbox",
      "id": "show_trust_row",
      "label": "Show trust row",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust item 1",
      "default": "✓ Free shipping"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust item 2",
      "default": "✓ 30-day money-back guarantee"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust item 3",
      "default": "✓ Secure checkout"
    },
    {
      "type": "richtext",
      "id": "benefits",
      "label": "Benefits list",
      "default": "<ul><li>Clinically-inspired red light wavelength</li><li>Rechargeable & cordless</li><li>Just 10-15 minutes a day</li></ul>"
    }
  ],
  "presets": [
    {
      "name": "Product Showcase"
    }
  ]
}
{% endschema %}
