{{ 'lumatra.css' | asset_url | stylesheet_tag }}
<div class="lm-page lm-panelbg">
  <div class="lm-sec">
    <h2 class="lm-sec-t lm-tc" style="margin-bottom:30px">{{ section.settings.heading | default: 'Lumatra Promise' }}</h2>
    <div class="lm-perkgrid">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'rating' -%}
              <svg width="26" height="26" viewBox="0 0 26 26" fill="none" style="margin:0 auto 12px" aria-hidden="true"><circle cx="13" cy="13" r="11.5" stroke="#2b2320" stroke-width="1.3"/><path d="M13 6L14.8 10.6L19.7 11L15.9 14.1L17.1 19L13 16.3L8.9 19L10.1 14.1L6.3 11L11.2 10.6Z" stroke="#2b2320" stroke-width="1.1" stroke-linejoin="round"/></svg>
            {%- when 'support' -%}
              <svg width="26" height="26" viewBox="0 0 26 26" fill="none" style="margin:0 auto 12px" aria-hidden="true"><circle cx="13" cy="13" r="11.5" stroke="#2b2320" stroke-width="1.3"/><text x="13" y="17" font-size="9" text-anchor="middle" fill="#2b2320" font-weight="700">24</text></svg>
            {%- when 'secure' -%}
              <svg width="24" height="26" viewBox="0 0 24 26" fill="none" style="margin:0 auto 12px" aria-hidden="true"><path d="M12 1L22 4.5V11C22 17 17.5 21.5 12 24C6.5 21.5 2 17 2 11V4.5L12 1Z" stroke="#2b2320" stroke-width="1.3"/><path d="M7 13L10.5 16.5L17 9" stroke="#2b2320" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- else -%}
              <svg width="30" height="24" viewBox="0 0 30 24" fill="none" style="margin:0 auto 12px" aria-hidden="true"><path d="M1 5H19V19H1V5Z" stroke="#2b2320" stroke-width="1.3"/><path d="M19 10H24L28 15V19H19V10Z" stroke="#2b2320" stroke-width="1.3"/><circle cx="8" cy="21" r="2.4" stroke="#2b2320" stroke-width="1.3"/><circle cx="23" cy="21" r="2.4" stroke="#2b2320" stroke-width="1.3"/></svg>
          {%- endcase -%}
          <div class="lm-perkcard__title">{{ block.settings.title }}</div>
          <div class="lm-perkcard__text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lumatra: Promise grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lumatra Promise" }
  ],
  "blocks": [
    { "type": "item", "name": "Promise item", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "shipping", "options": [
        { "value": "shipping", "label": "Shipping" },
        { "value": "rating", "label": "Rating" },
        { "value": "support", "label": "24/7 support" },
        { "value": "secure", "label": "Secure payment" }
      ]},
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ]}
  ],
  "presets": [
    {
      "name": "Lumatra: Promise grid",
      "blocks": [
        { "type": "item", "settings": { "icon": "shipping", "title": "Enjoy Fast Shipping", "text": "Enjoy fast & secure shipping anywhere in U.S." } },
        { "type": "item", "settings": { "icon": "rating", "title": "More than 100,000+ Lumatra Bags Sold", "text": "Trusted by more than 100,000 women and top rated as the must-have travel bag" } },
        { "type": "item", "settings": { "icon": "support", "title": "24/7 Live-Chat Support, just for you.", "text": "Get quick answers from our friendly support team, available 24/7." } },
        { "type": "item", "settings": { "icon": "secure", "title": "SSL Encryption for Safe and Secure Payments", "text": "SSL-secured Shop Pay, Apple Pay, PayPal / Credit Card payments." } }
      ]
    }
  ]
}
{% endschema %}
