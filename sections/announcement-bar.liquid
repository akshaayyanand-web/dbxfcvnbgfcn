<div class="announcement-bar" {% if section.settings.autoplay and section.blocks.size > 1 %}data-autoplay="{{ section.settings.autoplay_speed }}"{% endif %}>
  {%- if section.blocks.size > 0 -%}
    <ul class="announcement-bar__list" role="list">
      {%- for block in section.blocks -%}
        <li class="announcement-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            <span>{{ block.settings.text }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate messages", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Rotate every", "min": 3, "max": 10, "step": 1, "default": 5, "unit": "s" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $50" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Free shipping on orders over $50" } },
      { "type": "message", "settings": { "text": "30-day money-back guarantee" } }
    ]
  }
}
{% endschema %}
