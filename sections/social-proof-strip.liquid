<section class="lc-social" data-section-id="{{ section.id }}">
  <div class="lc-wrap lc-social__inner">
    <div class="lc-social__avatars">
      {% for block in section.blocks %}
        {% if block.type == 'avatar' %}
          <span class="lc-social__avatar" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 80 }}" alt="{{ block.settings.image.alt | escape }}" width="40" height="40" loading="lazy">
            {% endif %}
          </span>
        {% endif %}
      {% endfor %}
    </div>
    <p class="lc-social__headline">
      {{ section.settings.headline }}
    </p>

    {% if section.settings.show_gallery %}
      <div class="lc-social__gallery">
        {% for block in section.blocks %}
          {% if block.type == 'gallery_image' %}
            <div class="lc-social__gallery-item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.caption | escape }}" width="300" height="360" loading="lazy">
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {% endif %}
              {% if block.settings.caption != blank %}
                <span class="lc-social__gallery-caption">{{ block.settings.caption }}</span>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .lc-social {
    padding: 48px 0 24px;
    text-align: center;
  }

  .lc-social__avatars {
    display: flex;
    justify-content: center;
    margin-bottom: 18px;
  }

  .lc-social__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--lc-pink-soft);
    margin-left: -10px;
    border: 2px solid var(--lc-white);
    display: inline-block;
  }

  .lc-social__avatar:first-child {
    margin-left: 0;
  }

  .lc-social__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lc-social__headline {
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 600;
    color: var(--lc-ink);
    margin: 0 0 40px;
  }

  .lc-social__headline em,
  .lc-social__headline b {
    color: var(--lc-pink-deep);
    font-style: normal;
  }

  .lc-social__gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .lc-social__gallery-item {
    position: relative;
    border-radius: var(--lc-radius-md);
    overflow: hidden;
    background: var(--lc-pink-soft);
    aspect-ratio: 4 / 5;
  }

  .lc-social__gallery-item img,
  .lc-social__gallery-item svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lc-social__gallery-caption {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    color: var(--lc-white);
    font-size: 13px;
    font-weight: 600;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    text-align: left;
  }

  @media screen and (max-width: 749px) {
    .lc-social__gallery {
      grid-template-columns: 1fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Social Proof Strip",
  "settings": [
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline",
      "default": "<p>Customers love our Red Light Glasses</p>"
    },
    {
      "type": "checkbox",
      "id": "show_gallery",
      "label": "Show inspiration gallery",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "avatar",
      "name": "Avatar",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        }
      ]
    },
    {
      "type": "gallery_image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Proof Strip",
      "blocks": [
        { "type": "avatar" },
        { "type": "avatar" },
        { "type": "avatar" },
        { "type": "avatar" },
        { "type": "avatar" },
        { "type": "gallery_image", "settings": { "caption": "Before" } },
        { "type": "gallery_image", "settings": { "caption": "During" } },
        { "type": "gallery_image", "settings": { "caption": "After" } }
      ]
    }
  ]
}
{% endschema %}
