<div class="how-it-works page-width color-scheme-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="how-it-works__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="how-it-works__modes">
    {%- for block in section.blocks -%}
      <div class="how-it-works__mode" {{ block.shopify_attributes }}>
        <div class="how-it-works__mode-icon" aria-hidden="true">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 300 }}"
              alt=""
              loading="lazy"
              width="72"
              height="72"
            >
          {%- endif -%}
        </div>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" }
      ],
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "mode",
      "name": "Mode",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Mode name" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A short explanation of what this mode does." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "mode", "settings": { "title": "Mode one", "text": "Explain what this setting targets and why." } },
      { "type": "mode", "settings": { "title": "Mode two", "text": "Explain what this setting targets and why." } }
    ]
  },
  "presets": [{ "name": "How it works" }]
}
{% endschema %}
