<div class="results page-width color-scheme-{{ section.settings.color_scheme }}">
  <div class="results__head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p>{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="results__body">
    <div class="results__compare">
      {%- if section.settings.image_before != blank -%}
        <div class="results__compare-image">
          <img
            src="{{ section.settings.image_before | image_url: width: 700 }}"
            alt="{{ section.settings.image_before.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.image_before.width }}"
            height="{{ section.settings.image_before.height }}"
          >
          <span class="results__compare-tag">Before</span>
        </div>
      {%- endif -%}
      {%- if section.settings.image_after != blank -%}
        <div class="results__compare-image">
          <img
            src="{{ section.settings.image_after | image_url: width: 700 }}"
            alt="{{ section.settings.image_after.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.image_after.width }}"
            height="{{ section.settings.image_after.height }}"
          >
          <span class="results__compare-tag results__compare-tag--after">After</span>
        </div>
      {%- endif -%}
    </div>

    <ul class="results__list" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <span class="results__check" aria-hidden="true">&#10003;</span>
          {{ block.settings.text }}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Product results",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See visible results in 30 days" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Consistent use is the difference between hoping and seeing." },
    { "type": "image_picker", "id": "image_before", "label": "Before image" },
    { "type": "image_picker", "id": "image_after", "label": "After image" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" }
      ],
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "result",
      "name": "Result",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Noticeably smoother texture" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "result", "settings": { "text": "Noticeably smoother texture" } },
      { "type": "result", "settings": { "text": "More even, brighter tone" } },
      { "type": "result", "settings": { "text": "Reduced look of fine lines" } }
    ]
  },
  "presets": [{ "name": "Product results" }]
}
{% endschema %}
