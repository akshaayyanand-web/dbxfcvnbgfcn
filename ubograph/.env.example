# Copy this file to .env and paste your keys after the "=" signs.
# .env is git-ignored. Never commit real keys.

OPENSANCTIONS_API_KEY=
OPENCORPORATES_API_TOKEN=

# Adverse media is a structured keyword search (see keywords.py) — no API
# key or configuration needed, always on.

# Optional overrides
# An OpenSanctions /match candidate scoring below this is dropped rather than
# reported as the searched entity — see README.md "Adverse media".
MATCH_SCORE_THRESHOLD=0.5
OPENSANCTIONS_BASE_URL=https://api.opensanctions.org
OPENCORPORATES_BASE_URL=https://api.opencorporates.com/v0.4
HTTP_TIMEOUT=30
PORT=5000
