# Copy this file to .env and paste your keys after the "=" signs.
# .env is git-ignored. Never commit real keys.

OPENSANCTIONS_API_KEY=
OPENCORPORATES_API_TOKEN=

# Optional: enables the adverse-media fallback when no structured match is found.
# Set either (or both) — Anthropic is used when both are present, unless
# ADVERSE_MEDIA_PROVIDER below says otherwise.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
ADVERSE_MEDIA_PROVIDER=auto
OPENSANCTIONS_BASE_URL=https://api.opensanctions.org
OPENCORPORATES_BASE_URL=https://api.opencorporates.com/v0.4
HTTP_TIMEOUT=30
PORT=5000
