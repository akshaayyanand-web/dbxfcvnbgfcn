//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// Topstep NQ Intraday Momentum – $50K Trading Combine edition  (MNQ micro contracts; 1-hour chart)
//
// Chart: OANDA:NAS100USD (real-time on free plans) or CME_MINI:MNQ1! / CME_MINI:NQ1!, 1 hour.
//   Reference: close of the hourly bar ending 16:00 New York (previous session).
//   Signal   : at 11:00 New York, if the Nasdaq moved more than 0.6% from that reference, trade that way at the 11:00 open.
//   Stop     : 1.5 x ATR(24) (attached).   Exit: 15:00 New York = 14:00 CT, before Topstep's 15:10 CT cut-off.
// Sizing in WHOLE MNQ contracts ($2 per point): contracts = risk $ / (stop points x 2), rounded down;
//   1 contract if that rounds to 0 but 1 contract risks at most 1.5 x the risk $; otherwise the trade is skipped.
// Topstep rules tracked on the chart (profit target, trailing end-of-day Maximum Loss Limit, consistency, daily loss
//   guard), as in topstep_nq_orb.pine. The tracker only sees THIS script's trades: watch the real account on TopstepX.
// Part of the FAST PLAN: run with topstep_nq_orb.pine, topstep_es_orb.pine and topstep_gold_mom.pine, each at $400 risk.
// Python test of the 4-strategy fast plan at $400 each (resetting after a fail), Combine starts 2023-25 (not used to pick it):
//   funded within 1 month 40%, within 2 months 81%, within 3 months 93%; 1.7 resets on average. A backtest, not a promise.
// ─────────────────────────────────────────────────────────────────────────────
strategy("Topstep NQ Intraday Momentum (MNQ)", shorttitle = "Topstep NQ Mom", overlay = true,
     initial_capital = 50000, pyramiding = 0,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.4,
     slippage = 1, margin_long = 0, margin_short = 0)

G_E = "Setup (New York clock)"
refHour    = input.int(16, "Reference close: bar ending at hour", minval = 0, maxval = 23, group = G_E)
thrPct     = input.float(0.6, "Move needed by the signal hour vs the reference close (%)", minval = 0.1, step = 0.1, group = G_E)
sigHour    = input.int(11, "Signal at (hour)", minval = 1, maxval = 23, group = G_E)
exitHour   = input.int(15, "Exit at (hour)", minval = 2, maxval = 20, group = G_E)
atrMult    = input.float(1.5, "Stop (x ATR 24)", minval = 0.5, step = 0.1, group = G_E)
allowShort = input.bool(true, "Also trade down days (short)", group = G_E)

G_S = "Sizing (MNQ micro contracts)"
riskUsd    = input.float(400, "Risk per trade ($)", minval = 20, step = 10, group = G_S)
ptValue    = input.float(2.0, "Dollars per point per contract (MNQ = 2, NQ = 20)", minval = 1, step = 1, group = G_S)
maxContr   = input.int(10, "Max contracts", minval = 1, group = G_S)
cname      = input.string("MNQ", "Contract name (for alerts)", group = G_S)

G_T = "Topstep Combine rules"
acct       = input.float(50000, "Starting balance", minval = 1000, step = 1000, group = G_T)
targetUsd  = input.float(3000, "Profit target ($)", minval = 100, step = 100, group = G_T)
mllUsd     = input.float(2000, "Maximum Loss Limit ($, trailing end-of-day)", minval = 100, step = 100, group = G_T)
consPct    = input.float(50, "Consistency: best day at most this % of total profit", minval = 10, maxval = 100, step = 5, group = G_T)
dllUsd     = input.float(1000, "Daily loss guard ($, no new trades after this loss today)", minval = 50, step = 50, group = G_T)
bufferUsd  = input.float(300, "Guard buffer above the Maximum Loss line ($)", minval = 0, step = 50, group = G_T)
stopAtPass = input.bool(true, "Stop trading once the Combine is passed", group = G_T)

string tz = "America/New_York"
bool  tfOK = timeframe.in_seconds() == 3600
int   nh   = hour(time, tz)
float atrV = ta.rma(ta.tr(true), 24)
var float refClose = na
if nh == (refHour + 23) % 24
    refClose := close

// ── Topstep account tracking (trading day ends 17:00 Chicago) ──
float balance   = acct + strategy.netprofit
int   ctShift   = hour(time, "America/Chicago") >= 17 ? 1 : 0
int   tDay      = dayofyear(time, "America/Chicago") + ctShift
bool  newTDay   = tDay != tDay[1]
var float dayStartBal = acct
var float eodHigh     = acct
var float bestDay     = 0.0
var bool  passed      = false
var bool  failed      = false
if newTDay
    bestDay := math.max(bestDay, balance - dayStartBal)
    eodHigh := math.max(eodHigh, balance)
    dayStartBal := balance
    float prof0 = balance - acct
    if prof0 >= targetUsd and bestDay <= consPct / 100 * prof0
        passed := true
float mllLine = math.min(acct, eodHigh - mllUsd)
if strategy.equity <= mllLine
    failed := true
float dayPnl = strategy.equity - dayStartBal
bool  guardStop = strategy.equity - mllLine <= bufferUsd or dayPnl <= -dllUsd
if strategy.position_size != 0 and strategy.equity - mllLine <= bufferUsd * 0.5
    strategy.close_all(comment = "Guard: near Maximum Loss Limit")

// ── signal ──
float pos  = strategy.position_size
float move = na(refClose) ? na : close / refClose - 1
int   dir  = na(move) ? 0 : move > thrPct / 100 ? 1 : (move < -thrPct / 100 and allowShort) ? -1 : 0
bool  blocked = failed or guardStop or (stopAtPass and passed)
bool  sig = tfOK and nh == sigHour - 1 and pos == 0 and dir != 0 and not blocked and not na(atrV)

float stopDist = atrMult * atrV
float oneRisk  = stopDist * ptValue
int   contr    = oneRisk > 0 ? int(math.floor(riskUsd / oneRisk)) : 0
if contr == 0 and oneRisk > 0 and oneRisk <= 1.5 * riskUsd
    contr := 1
contr := math.min(contr, maxContr)
float qty = contr * ptValue / syminfo.pointvalue

var float stopPx = na
if sig and contr > 0
    stopPx := close - dir * stopDist
    strategy.entry("GM", dir == 1 ? strategy.long : strategy.short, qty = qty, comment = (dir == 1 ? "Long " : "Short ") + str.tostring(contr) + " " + cname)
    strategy.exit("Stop", "GM", stop = stopPx)
    alert("TOPSTEP NQ MOMENTUM " + (dir == 1 ? "BUY " : "SELL ") + str.tostring(contr) + " " + cname + " at the 11:00 New York open ~" + str.tostring(close, "#.##") +
          " | STOP " + str.tostring(stopPx, "#.##") + " | risk ~$" + str.tostring(contr * oneRisk, "#") + " | exit 15:00 New York (14:00 CT)", alert.freq_once_per_bar_close)

if strategy.position_size != 0
    strategy.exit("Stop", "GM", stop = stopPx)
    if nh >= exitHour - 1
        strategy.close("GM", comment = "Time exit 15:00 NY")
        alert("TOPSTEP NQ MOMENTUM | EXIT: close the " + cname + " position now (15:00 New York)", alert.freq_once_per_bar_close)

// ── chart ──
plot(refClose, "Reference close", color = color.new(color.blue, 30), style = plot.style_stepline)
var table tb = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 20))
if barstate.islastconfirmedhistory or barstate.isrealtime
    float prof = balance - acct
    string status = failed ? "FAILED (hit Maximum Loss)" : passed ? "PASSED – stop trading" : guardStop ? "Guard: no new trades" : "Trading"
    table.cell(tb, 0, 0, "Status", text_color = color.white)
    table.cell(tb, 1, 0, status, text_color = failed ? color.red : passed ? color.lime : guardStop ? color.orange : color.white)
    table.cell(tb, 0, 1, "Profit / target", text_color = color.white)
    table.cell(tb, 1, 1, "$" + str.tostring(prof, "#,###") + " / $" + str.tostring(targetUsd, "#,###"), text_color = prof >= 0 ? color.lime : color.red)
    table.cell(tb, 0, 2, "Max Loss line", text_color = color.white)
    table.cell(tb, 1, 2, "$" + str.tostring(mllLine, "#,###") + "  (room $" + str.tostring(strategy.equity - mllLine, "#,###") + ")", text_color = strategy.equity - mllLine > 1000 ? color.lime : color.orange)
    table.cell(tb, 0, 3, "Best day / consistency", text_color = color.white)
    table.cell(tb, 1, 3, "$" + str.tostring(bestDay, "#,###") + (prof > 0 ? " = " + str.tostring(bestDay / prof * 100, "#") + "% of profit" : ""), text_color = color.white)
    table.cell(tb, 0, 4, "Today", text_color = color.white)
    table.cell(tb, 1, 4, "$" + str.tostring(dayPnl, "#,###"), text_color = dayPnl >= 0 ? color.lime : color.red)
    table.cell(tb, 0, 5, "Next trade size", text_color = color.white)
    table.cell(tb, 1, 5, str.tostring(contr) + " " + cname + " (risk ~$" + str.tostring(contr * oneRisk, "#") + ")", text_color = color.white)
if (barstate.islastconfirmedhistory or barstate.isrealtime) and not tfOK
    label.new(bar_index, high, "Use the 1-hour chart", color = color.red, textcolor = color.white)
