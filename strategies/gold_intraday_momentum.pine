//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// Gold Intraday Momentum – day trade with prop guard  (XAUUSD or GC/MGC, 1h chart, London clock)
//
//   Reference: close of the hourly bar ending at 17:00 London (previous session).
//   Signal   : at 09:00 London, if gold has moved more than 0.6% from that reference, trade in the same
//              direction at the 09:00 bar's open.   Stop: 1.0 x ATR(24), attached.   Exit: 16:00 London.
//
// Python test (Dukascopy XAUUSD hourly, costs included): about +0.20R per trade 2016-2022 and +0.10R
// 2023-2026, ~5 trades a month; at 1% risk about +11%/yr then +7%/yr. Portfolio weight 0.25% risk.
// Paper trade first.
// ─────────────────────────────────────────────────────────────────────────────
strategy("Gold Intraday Momentum – prop guard", shorttitle = "Gold Intraday Mom", overlay = true,
     initial_capital = 100000, pyramiding = 0,
     commission_type = strategy.commission.percent, commission_value = 0.005,
     slippage = 1, margin_long = 0, margin_short = 0)

G_E = "Setup (session clock)"
tz       = input.string("Europe/London", "Session time zone", options = ["America/New_York", "Europe/London"], group = G_E)
refHour    = input.int(17, "Reference close: bar ending at hour", minval = 0, maxval = 23, group = G_E)
thrPct     = input.float(0.6, "Move needed by the signal hour vs the reference close (%)", minval = 0.1, step = 0.1, group = G_E)
sigHour    = input.int(9, "Signal at (hour)", minval = 1, maxval = 23, group = G_E)
exitHour   = input.int(16, "Exit at (hour)", minval = 2, maxval = 23, group = G_E)
atrMult    = input.float(1.0, "Stop (x ATR 24)", minval = 0.5, step = 0.1, group = G_E)
allowShort = input.bool(true, "Also trade down days (short)", group = G_E)

G_S = "Sizing & prop guard (this script's share of the account limits)"
riskPct    = input.float(0.25, "Risk per trade (% of balance)", minval = 0.05, maxval = 3, step = 0.05, group = G_S)
maxSizeX   = input.float(3.0, "Max position (x balance)", minval = 0.1, step = 0.5, group = G_S)
useGuard   = input.bool(true, "Safety guard ON", group = G_S)
maxLossPct = input.float(10, "Backstop: max loss from START balance (%) – the account limit", minval = 0.25, step = 0.25, group = G_S)
dailyPct   = input.float(0.45, "Share of daily loss limit (%)", minval = 0.05, step = 0.05, group = G_S)
guardShare = input.float(60, "Guard: max share of remaining room one trade may risk (%)", minval = 10, maxval = 100, step = 5, group = G_S)

bool  tfOK = timeframe.in_seconds() == 3600
int   nh   = hour(time, tz)
float atrV = ta.rma(ta.tr(true), 24)

// reference: close of the bar that ends at refHour (previous session)
var float refClose = na
if nh == (refHour + 23) % 24
    refClose := close

// ── accounting & guard ──
float startBal = strategy.initial_capital
float balance  = strategy.initial_capital + strategy.netprofit
float failLine = startBal * (1 - maxLossPct / 100)
var float dayOpen  = strategy.initial_capital
var bool  dayHalt  = false
var bool  hardHalt = false
if dayofmonth(time, "UTC") != dayofmonth(time[1], "UTC")
    dayOpen := balance
    dayHalt := false
float dayLimit = dayOpen * dailyPct / 100
if useGuard and strategy.position_size != 0 and dayOpen - strategy.equity >= 0.8 * dayLimit
    strategy.close_all(comment = "Guard: daily")
    dayHalt := true
if useGuard and strategy.position_size != 0 and strategy.equity - failLine <= startBal * maxLossPct / 100 * 0.2
    strategy.close_all(comment = "Guard: max loss")
    hardHalt := true

// ── signal on the close of the bar ending at sigHour ──
float pos  = strategy.position_size
float move = na(refClose) ? na : close / refClose - 1
bool atSignal = nh == sigHour - 1
int  dir = na(move) ? 0 : move > thrPct / 100 ? 1 : (move < -thrPct / 100 and allowShort) ? -1 : 0
bool sig = tfOK and atSignal and pos == 0 and dir != 0 and not dayHalt and not hardHalt and not na(atrV)

float riskCash = balance * riskPct / 100
if useGuard
    float dayRoom = dayLimit - math.max(dayOpen - balance, 0)
    riskCash := math.min(riskCash, dayRoom * guardShare / 100, math.max(balance - failLine, 0) * guardShare / 100)
float stopDist = atrMult * atrV
float qty = stopDist > 0 and riskCash > balance * 0.0005 ? math.min(riskCash / stopDist, balance * maxSizeX / close) : 0.0

var float stopPx = na
if sig and qty > 0
    stopPx := close - dir * stopDist
    strategy.entry("IM", dir == 1 ? strategy.long : strategy.short, qty = qty, comment = dir == 1 ? "Mom long" : "Mom short")
    strategy.exit("Stop", "IM", stop = stopPx)
    alert(syminfo.ticker + " INTRADAY MOMENTUM " + (dir == 1 ? "LONG" : "SHORT") + " at the open ~" + str.tostring(close, "#.##") +
          " | qty " + str.tostring(qty, "#.###") + " | STOP " + str.tostring(stopPx, "#.##") + " | exit " + str.tostring(exitHour) + ":00",
          alert.freq_once_per_bar_close)

if strategy.position_size != 0
    strategy.exit("Stop", "IM", stop = stopPx)
    if nh >= exitHour - 1
        strategy.close("IM", comment = "Time exit")

plot(refClose, "Reference close", color = color.new(color.blue, 30), style = plot.style_stepline)
if barstate.islast and not tfOK
    label.new(bar_index, high, "Use the 1h chart", color = color.red, textcolor = color.white)
